// Command boot is OctoForth as the board boots it with no loader, from
// its flash (scripts/flash.sh) or from an SD card as _BOOT_P2.BIX: the
// REPL of main.ogo, which first interprets the startup file, sd:boot.fth
// if the card in the slot has one and flash:boot.fth if not, unless a key
// comes within half a second.

import (
	"modernc.org/oforth/forth"
)

// The Forth's code and data spaces, as main.ogo's.
var (
	code [32768]uint32
	data [40960]uint32
)

func main() {
	forth.Serial()
	forth.Init(code[:], data[:])
	forth.Banner()
	if !forth.Boot("sd:boot.fth") {
		forth.Boot("flash:boot.fth")
	}
	forth.Quit() // until BYE
	forth.Exit(0)
}
