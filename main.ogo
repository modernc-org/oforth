// Command oforth is OctoForth's REPL on the serial line: a Forth that
// compiles every colon definition to P2 machine code as it is defined.

import (
	"modernc.org/oforth/forth"
)

// The Forth's code and data spaces, the room a Forth program has: 128 KB
// and 160 KB.
var (
	code [32768]uint32
	data [40960]uint32
)

func main() {
	forth.Serial()
	forth.Init(code[:], data[:])
	forth.Banner()
	forth.Quit() // until BYE
	forth.Exit(0)
}
