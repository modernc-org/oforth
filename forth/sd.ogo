import (
	"p2"
)

// The SD card in the slot of a P2 Edge module, read and written in blocks of
// 512 bytes over SPI, driven pin by pin by the cog that opened it, with no
// smart pin and no cog of its own. It is p2-11's sd package
// (modernc.org/p2-11/sd, by the same author) made this package's functions.
// What is read is checked against the checksum the card sends with it, and
// the card checks what it is sent the same way. A card of 2 GB or less counts
// in bytes and a larger one in blocks; sdShift makes both count in blocks.
// The slot's pins are the flash's too, with the clock and the select swapped:
// the flash's select falls only while its clock stands, and its clock moves
// once at most before the select rises again, so the card's traffic never
// gives the flash a whole byte.

const (
	sdClock  = 61
	sdSelect = 60
	sdIn     = 59 // the card's input
	sdOut    = 58 // and its output

	blockSize = 512

	// The commands, by their numbers.
	sdGoIdle      = 0
	sdSendIfCond  = 8
	sdSendCSD     = 9
	sdSendStatus  = 13
	sdSetBlockLen = 16
	sdReadBlock   = 17
	sdWriteBlock  = 24
	sdAppOpCond   = 41 // which is for the card after sdAppCommand only
	sdAppCommand  = 55
	sdReadOCR     = 58
	sdCRCOnOff    = 59

	sdIdle    = 1 << 0 // what a card answers while it is being set up
	sdIllegal = 1 << 2 // and to a command it does not know
	sdNothing = 0xff   // what is sent when there is nothing to send
	sdToken   = 0xfe   // what comes before a block, from whoever sends it
	sdTaken   = 0x05   // what the card answers a block it was sent
	sdDamaged = 0x0b   // and one whose checksum is not its own

	// A card being set up takes a clock of 400 kHz at most: half a cycle
	// of 2 us and what the code takes make it about 200 kHz. After that the
	// clock stays low sdSettle clocks beyond what the code takes, so that
	// the bit the card changes when its clock falls is the bit read next;
	// p2-11 measured 3 the least that does, at 160 and at 200 MHz.
	sdHalfCycle = 2
	sdSettle    = 8

	sdSettingUp = 1000 // ms a card is given to become ready
	sdPatience  = 500  // and to bring a block or to write one

	sdVoltages     = 0x1aa   // asks whether the card works at 2.7 to 3.6 V
	sdHighCapacity = 1 << 30 // that a card counts in blocks
)

var (
	sdSlow   bool   // the clock is a card's being set up
	sdShift  uint32 // a block's number shifted left by it is its address
	sdBlocks uint32 // how many the card has, 0 when none is open
	sdCRCs   [256]uint16
)

// sdOpen sets up the card in the slot, which may have been set up before
// or taken out and put back, and answers whether there is one, what went
// wrong being in nineErr.
func sdOpen() bool {
	if sdCRCs[1] == 0 {
		for i := range sdCRCs {
			crc := uint16(i) << 8
			for n := 0; n < 8; n++ {
				if crc&0x8000 != 0 {
					crc = crc<<1 ^ 0x1021
				} else {
					crc <<= 1
				}
			}
			sdCRCs[i] = crc
		}
	}
	sdBlocks = 0
	sdSlow = true

	// The card's output is pulled up, so that an empty slot reads as
	// nothing rather than as whatever comes.
	p2.PinFloat(sdOut)
	p2.WritePinMode(sdOut, p2.DriveHigh15K|p2.DriveLowFloat)
	p2.PinHigh(sdOut)
	p2.PinHigh(sdSelect)
	p2.PinHigh(sdIn)
	p2.PinLow(sdClock)

	// A card wants a millisecond of power and 74 clocks before its first
	// command.
	p2.WaitMs(1)
	for i := 0; i < 10; i++ {
		sdTransfer(sdNothing)
	}
	p2.PinLow(sdSelect)
	ok := sdSetUp()
	sdRelease()
	return ok
}

// CardRead reads block n of the SD card in the slot into p, which is 512
// bytes, setting the card up first if it is not, and answers whether it
// could. It is for a program that wants the card's blocks, as
// scripts/carddump does; one that uses the Forth's files on the card wants
// none.
func CardRead(n uint32, p []byte) bool {
	if len(p) != blockSize || sdBlocks == 0 && !sdOpen() {
		return false
	}
	return sdRead(n, p)
}

// sdRead reads block b into p, which is blockSize bytes.
func sdRead(b uint32, p []byte) bool {
	if b >= sdBlocks {
		setNineErr("no such block on the card")
		return false
	}
	p2.PinLow(sdSelect)
	ok := false
	if sdCommand(sdReadBlock, b<<sdShift) == 0 {
		ok = sdReceive(p)
	} else {
		setNineErr("the card refused to read")
	}
	sdRelease()
	return ok
}

// sdWrite writes p, which is blockSize bytes, to block b; the block is on
// the card when it returns.
func sdWrite(b uint32, p []byte) bool {
	if b >= sdBlocks {
		setNineErr("no such block on the card")
		return false
	}
	p2.PinLow(sdSelect)
	ok := false
	if sdCommand(sdWriteBlock, b<<sdShift) == 0 {
		ok = sdSend(p)
	} else {
		setNineErr("the card refused to write")
	}
	sdRelease()
	return ok
}

// sdSetUp brings a card from whatever state it is in to where it reads and
// writes blocks, and finds out what kind of card it is.
func sdSetUp() bool {
	// A card stopped in the middle of a block has the rest of it to send
	// before it listens.
	r := byte(sdNothing)
	for try := 0; try < 100 && r != sdIdle; try++ {
		r = sdCommand(sdGoIdle, 0)
	}
	if r != sdIdle {
		setNineErr("no card in the slot")
		return false
	}

	// A card that does not know the question is of the standard's first
	// version, which had no card of high capacity.
	capacity := uint32(0)
	if sdCommand(sdSendIfCond, sdVoltages)&sdIllegal == 0 {
		if sdWord()&0xfff != sdVoltages {
			setNineErr("a card of no kind known here")
			return false
		}
		capacity = sdHighCapacity
	}
	start := p2.GetMs()
	for r != 0 {
		sdCommand(sdAppCommand, 0)
		r = sdCommand(sdAppOpCond, capacity)
		if r&^sdIdle != 0 {
			setNineErr("a card of no kind known here")
			return false
		}
		if p2.GetMs()-start > sdSettingUp {
			setNineErr("the card took too long")
			return false
		}
	}
	sdShift = 9
	if capacity != 0 {
		if sdCommand(sdReadOCR, 0) != 0 {
			setNineErr("the card refused a command")
			return false
		}
		if sdWord()&sdHighCapacity != 0 {
			sdShift = 0
		}
	}
	if sdCommand(sdCRCOnOff, 1) != 0 || sdShift != 0 && sdCommand(sdSetBlockLen, blockSize) != 0 {
		setNineErr("the card refused a command")
		return false
	}
	sdSlow = false
	return sdSize()
}

// sdSize asks the card how large it is, of which there are two ways to say,
// the first a card's that counts in bytes.
func sdSize() bool {
	if sdCommand(sdSendCSD, 0) != 0 {
		setNineErr("the card refused a command")
		return false
	}
	var csd [16]byte
	if !sdReceive(csd[:]) {
		return false
	}
	switch csd[0] >> 6 {
	case 0:
		size := uint32(csd[6]&0x03)<<10 | uint32(csd[7])<<2 | uint32(csd[8])>>6
		multiplier := uint32(csd[9]&0x03)<<1 | uint32(csd[10])>>7
		blockLen := uint32(csd[5] & 0x0f)
		if blockLen < 9 {
			setNineErr("a card of no kind known here")
			return false
		}
		sdBlocks = (size + 1) << (multiplier + 2) << (blockLen - 9)
	case 1:
		size := uint32(csd[7]&0x3f)<<16 | uint32(csd[8])<<8 | uint32(csd[9])
		sdBlocks = (size + 1) << 10
	default:
		setNineErr("a card of no kind known here")
		return false
	}
	return true
}

// sdRelease lets go of the card, which lets go of its output a byte later.
func sdRelease() {
	p2.PinHigh(sdSelect)
	sdTransfer(sdNothing)
}

// sdCommand sends a command and answers what the card says to it, which is
// sdNothing if it says nothing.
func sdCommand(number byte, argument uint32) byte {
	sdTransfer(sdNothing)
	b := 0x40 | number
	crc := crc7(0, b)
	sdTransfer(b)
	for shift := 24; shift >= 0; shift -= 8 {
		b = byte(argument >> uint32(shift))
		crc = crc7(crc, b)
		sdTransfer(b)
	}
	sdTransfer(crc<<1 | 1)
	r := byte(sdNothing)
	for i := 0; i < 10 && r&0x80 != 0; i++ {
		r = sdTransfer(sdNothing)
	}
	return r
}

// crc7 answers the checksum of a command, of which v is the next byte and
// crc the checksum so far.
func crc7(crc, v byte) byte {
	for i := 0; i < 8; i++ {
		crc <<= 1
		if (crc^v)&0x80 != 0 {
			crc ^= 0x09
		}
		v <<= 1
	}
	return crc
}

// sdWord answers the four bytes that follow what the card says to some of
// the commands.
func sdWord() uint32 {
	v := uint32(0)
	for i := 0; i < 4; i++ {
		v = v<<8 | uint32(sdTransfer(sdNothing))
	}
	return v
}

// sdWait answers the first byte the card sends that is not begin, or begin
// if none comes in time. A busy card sends zeros, and one looking for a
// block sends nothing.
func sdWait(begin byte) byte {
	start := p2.GetMs()
	for p2.GetMs()-start <= sdPatience {
		if v := sdTransfer(sdNothing); v != begin {
			return v
		}
	}
	return begin
}

// sdReceive reads what the card sends after a command that asks for data:
// the token, as many bytes as p has, and their checksum.
func sdReceive(p []byte) bool {
	switch sdWait(sdNothing) {
	case sdToken:
	case sdNothing:
		setNineErr("the card took too long")
		return false
	default:
		setNineErr("the card refused to read")
		return false
	}
	crc := sdReadBytes(p)
	high := sdTransfer(sdNothing)
	low := sdTransfer(sdNothing)
	if crc != uint16(high)<<8|uint16(low) {
		setNineErr("what the card sent did not arrive")
		return false
	}
	return true
}

// sdSend writes what the card wants after a command that brings data, the
// token, the bytes of p and their checksum, and waits until the card has
// done with them.
func sdSend(p []byte) bool {
	sdTransfer(sdNothing)
	sdTransfer(sdToken)
	crc := sdWriteBytes(p)
	sdTransfer(byte(crc >> 8))
	sdTransfer(byte(crc))
	switch sdTransfer(sdNothing) & 0x1f {
	case sdTaken:
	case sdDamaged:
		setNineErr("what was sent did not arrive at the card")
		return false
	default:
		setNineErr("the card could not write the block")
		return false
	}
	if sdWait(0) == 0 {
		setNineErr("the card took too long")
		return false
	}

	// That the block was taken does not say that it was written.
	if sdCommand(sdSendStatus, 0) != 0 || sdTransfer(sdNothing) != 0 {
		setNineErr("the card could not write the block")
		return false
	}
	return true
}

// sdTransfer sends a byte and answers the one that came meanwhile, both with
// the most significant bit first. The card takes a bit when the clock rises
// and changes its own when the clock falls.
func sdTransfer(out byte) byte {
	in := byte(0)
	for i := 0; i < 8; i++ {
		p2.PinWrite(sdIn, int(out>>7))
		out <<= 1
		if sdSlow {
			p2.WaitUs(sdHalfCycle)
		} else {
			p2.WaitCycles(sdSettle)
		}
		p2.PinHigh(sdClock)
		in = in<<1 | byte(p2.PinIn(sdOut))
		if sdSlow {
			p2.WaitUs(sdHalfCycle)
		}
		p2.PinLow(sdClock)
	}
	return in
}

// sdReadBytes fills p with what the card sends and answers its checksum: it
// is sdTransfer for many bytes, with nothing else in the loop than they need.
func sdReadBytes(p []byte) uint16 {
	crc := uint32(0)
	p2.PinHigh(sdIn)
	for i := range p {
		v := uint32(0)
		for n := 8; n != 0; n-- {
			p2.WaitCycles(sdSettle)
			p2.PinHigh(sdClock)
			v = v<<1 | uint32(p2.PinIn(sdOut))
			p2.PinLow(sdClock)
		}
		p[i] = byte(v)
		crc = crc<<8&0xff00 ^ uint32(sdCRCs[crc>>8^v])
	}
	return uint16(crc)
}

// sdWriteBytes sends the card the bytes of p and answers their checksum.
func sdWriteBytes(p []byte) uint16 {
	crc := uint32(0)
	for i := range p {
		v := uint32(p[i])
		crc = crc<<8&0xff00 ^ uint32(sdCRCs[crc>>8^v])
		for n := 8; n != 0; n-- {
			p2.PinWrite(sdIn, int(v>>7&1))
			p2.PinHigh(sdClock)
			v <<= 1
			p2.PinLow(sdClock)
		}
	}
	p2.PinHigh(sdIn)
	return uint16(crc)
}
