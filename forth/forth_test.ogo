import (
	"testing"
	"unsafe"
)

// The tests run Forth source on the board and compare what it writes. Each
// leaves the stack empty, which check holds them to.

// The tests' code and data spaces, smaller than the REPL's, the test
// binary having to hold the tests too.
var (
	testCode [16384]uint32
	testData [16384]uint32
)

// testOut is where the output goes, for the tests read it.
var testOut [2048]byte

func init() {
	out = testOut[:]
	Init(testCode[:], testData[:])
}

func same(got []byte, want string) bool {
	if len(got) != len(want) {
		return false
	}
	for i, c := range got {
		if c != want[i] {
			return false
		}
	}
	return true
}

func show(s []byte) {
	for _, c := range s {
		if c == '\n' {
			printf("\\n")
			continue
		}
		printf("%c", c)
	}
}

func check(t *testing.T, src, want string) {
	ResetOutput()
	Evaluate(src)
	got := Output()
	if !same(got, want) {
		printf("%s\n   got: \"", src)
		show(got)
		printf("\"\n  want: \"%s\"\n", want)
		t.Fail()
	}
	if d := depth(); d != 0 {
		printf("%s\n  left %d on the stack\n", src, d)
		t.Fail()
		reset()
	}
}

func TestStack(t *testing.T) {
	check(t, "1 2 SWAP . .", "1 2 ")
	check(t, "1 2 OVER . . .", "1 2 1 ")
	check(t, "1 2 3 ROT . . .", "1 3 2 ")
	check(t, "1 2 3 -ROT . . .", "2 1 3 ")
	check(t, "1 2 NIP .", "2 ")
	check(t, "1 2 TUCK . . .", "2 1 2 ")
	check(t, "0 ?DUP . 5 ?DUP . .", "0 5 5 ")
	check(t, "1 2 2DUP . . . .", "2 1 2 1 ")
	check(t, "1 2 3 2DROP .", "1 ")
	check(t, "1 2 3 4 2SWAP . . . .", "2 1 4 3 ")
	check(t, "1 2 3 4 2OVER . . . . . .", "2 1 4 3 2 1 ")
	check(t, "10 20 30 2 PICK . DROP DROP DROP", "10 ")
	check(t, "1 2 3 DEPTH . DROP DROP DROP", "3 ")
	check(t, "1 2 3 .S DROP DROP DROP", "<3> 1 2 3 ")
	check(t, ": t1 >R 1 R> ; 5 t1 . .", "5 1 ")
	check(t, ": t2 >R R@ R> ; 7 t2 . .", "7 7 ")
	check(t, ": t3 2>R 2R@ 2R> ; 1 2 t3 . . . .", "2 1 2 1 ")
	check(t, "drop", "error: stack underflow\n")
	check(t, ".", "error: stack underflow\n")
}

func TestArithmetic(t *testing.T) {
	check(t, "1 2 + .", "3 ")
	check(t, "10 3 - .", "7 ")
	check(t, "6 7 * .", "42 ")
	check(t, "-7 2 / . 7 -2 / . 7 2 / .", "-3 -3 3 ")
	check(t, "-7 2 MOD . 7 -2 MOD .", "-1 1 ")
	check(t, "7 2 /MOD . . -7 2 /MOD . .", "3 1 -3 -1 ")
	check(t, "3 5 MIN . 3 5 MAX . -3 -5 MIN . -4 ABS . 4 NEGATE .", "3 5 -5 4 -4 ")
	check(t, "5 1+ . 5 1- . 5 2* . -5 2/ .", "6 4 10 -3 ")
	check(t, "1 4 LSHIFT . 256 4 RSHIFT . -1 28 RSHIFT .", "16 16 15 ")
	check(t, "$F0 $3C AND . $F0 $0F OR . $FF $0F XOR . 0 INVERT .", "48 255 240 -1 ")
	check(t, "1 2 = . 2 2 = . 1 2 <> . 1 2 < . 2 1 > . -1 1 < .", "0 -1 -1 -1 -1 -1 ")
	check(t, "-1 0 U< . 0 -1 U< . -1 0 U> .", "0 -1 -1 ")
	check(t, "0 0= . 5 0= . -5 0< . 5 0< . 5 0> . -5 0> . 0 0<> .", "-1 0 -1 0 -1 0 0 ")
	check(t, "5 1 10 WITHIN . 10 1 10 WITHIN . 0 1 10 WITHIN .", "-1 0 0 ")
	check(t, "-1 2 UM* . . 10 0 3 UM/MOD . .", "1 -2 3 1 ")
	check(t, "-3 4 M* . . 3 4 M* . .", "-1 -12 0 12 ")
	check(t, "10 20 3 */ . 1000000 1000000 1000 */ .", "66 1000000000 ")
	check(t, "7 3 2 */MOD . .", "10 1 ")
	check(t, "-7 -1 2 FM/MOD . . -7 -1 2 SM/REM . .", "-4 1 -3 -1 ")
	check(t, "TRUE . FALSE . BL .", "-1 0 32 ")
	check(t, "3 CELLS . 1 CELL+ . 1 CHAR+ . 5 CHARS .", "12 5 2 5 ")
	check(t, "1 0 / DROP", "")
}

func TestNumbers(t *testing.T) {
	check(t, "$10 . #10 . %101 . 'x' . -12 .", "16 10 5 120 -12 ")
	check(t, "HEX FF . 10 . DECIMAL 10 .", "FF 10 10 ")
	check(t, "255 16 BASE ! . DECIMAL", "FF ")
	check(t, "16 BASE ! 255 . DECIMAL", "255 ")
	check(t, "-1 U. 5 3 .R 5 3 U.R", "4294967295   5  5")
	check(t, "1 ( a comment ) 2 + . \\ the rest", "3 ")
	check(t, "CHAR A . : c1 [CHAR] B ; c1 .", "65 66 ")
	check(t, "nonesuch", "nonesuch ?\n")
	check(t, "12x", "12x ?\n")
}

func TestMemory(t *testing.T) {
	check(t, "VARIABLE v 42 v ! v @ . 3 v +! v @ .", "42 45 ")
	check(t, "10 CONSTANT ten ten . : t4 ten 1+ ; t4 .", "10 11 ")
	check(t, "VARIABLE b $41 b C! b C@ . $1234 b W! b W@ .", "65 4660 ")
	check(t, "CREATE pair 0 , 0 , 1 2 pair 2! pair 2@ . .", "2 1 ")
	check(t, "CREATE buf 8 ALLOT buf 8 65 FILL buf 8 TYPE", "AAAAAAAA")
	check(t, "S\" xyz\" buf SWAP MOVE buf 3 TYPE", "xyz")
	check(t, "S\" hello\" . DROP", "5 ")
	check(t, "buf COUNT . DROP", "120 ")
	check(t, "HERE 4 ALLOT HERE SWAP - .", "4 ")
}

func TestCompile(t *testing.T) {
	check(t, ": sq DUP * ; 7 sq .", "49 ")
	check(t, ": f1 3 + ; 4 f1 .", "7 ")
	check(t, ": f2 -1 + ; 4 f2 .", "3 ")
	check(t, ": f3 100000 + ; 1 f3 .", "100001 ")
	check(t, ": f4 -100000 ; f4 .", "-100000 ")
	check(t, ": f5 123456789 ; f5 .", "123456789 ")
	check(t, ": f6 -5 ; f6 .", "-5 ")
	check(t, "VARIABLE w1 45 w1 ! : f7 w1 @ ; f7 .", "45 ")
	check(t, ": f8 9 w1 ! ; f8 w1 @ .", "9 ")
	check(t, ": f9 $FF AND 8 LSHIFT ; $1234 f9 .", "13312 ")
	check(t, ": f10 1 = ; 1 f10 . 2 f10 .", "-1 0 ")
	check(t, ": f11 3 * 7 - ; 5 f11 .", "8 ")
	check(t, ": f12 [ 2 3 + ] LITERAL ; f12 .", "5 ")
	check(t, ": sgn DUP 0< IF DROP -1 ELSE 0> IF 1 ELSE 0 THEN THEN ; -5 sgn . 0 sgn . 7 sgn .", "-1 0 1 ")
	check(t, ": cnt 0 BEGIN 1+ DUP 5 = UNTIL ; cnt .", "5 ")
	check(t, ": wh 0 BEGIN DUP 3 < WHILE 1+ REPEAT ; wh .", "3 ")
	check(t, ": ag 0 BEGIN 1+ DUP 4 = IF EXIT THEN AGAIN ; ag .", "4 ")
	check(t, ": d1 0 5 0 DO I + LOOP ; d1 .", "10 ")
	check(t, ": nest 3 0 DO 2 0 DO J 10 * I + . LOOP LOOP ; nest", "0 1 10 11 20 21 ")
	check(t, ": pl 10 0 DO I . 3 +LOOP ; pl", "0 3 6 9 ")
	check(t, ": mn 0 10 DO I . -3 +LOOP ; mn", "10 7 4 1 ")
	check(t, ": mn1 0 3 DO I . -1 +LOOP ; mn1", "3 2 1 0 ")
	check(t, ": lv 10 0 DO I 3 = IF LEAVE THEN I . LOOP ; lv", "0 1 2 ")
	check(t, ": qd 0 0 ?DO I . LOOP ; qd : qd2 3 0 ?DO I . LOOP ; qd2", "0 1 2 ")
	check(t, ": ul 10 0 DO I 2 = IF UNLOOP EXIT THEN I . LOOP ; ul", "0 1 ")
	check(t, ": fact DUP 1 > IF DUP 1- RECURSE * THEN ; 10 fact .", "3628800 ")
	check(t, ": ex 1 EXIT 2 ; ex .", "1 ")
	check(t, "3 ' DUP EXECUTE . .", "3 3 ")
	check(t, ": sq2 DUP * ; 5 ' sq2 EXECUTE .", "25 ")
	check(t, ": x1 ['] sq2 EXECUTE ; 6 x1 .", "36 ")
	check(t, "4 ' . EXECUTE", "4 ")
	check(t, ": hi .\" hello\" CR ; hi", "hello\n")
	check(t, ": e1 65 EMIT 66 EMIT ; e1", "AB")
	check(t, ": s1 S\" abc\" TYPE ; s1", "abc")
	check(t, ": sp 3 SPACES 42 EMIT SPACE ; sp", "   * ")
	check(t, ": two 1\n2 ;\ntwo . .", "2 1 ")
	check(t, ": ctr 0 SWAP 0 DO 1+ LOOP ; 1000 ctr .", "1000 ")
	check(t, ": imm 42 ; IMMEDIATE : use imm LITERAL ; use .", "42 ")
	check(t, ": t5 GET-CT GET-CT SWAP - ; t5 0> .", "-1 ")
}

func TestErrors(t *testing.T) {
	check(t, "IF", "IF is compile-only\n")
	check(t, ": bad IF ;", "error: unbalanced control structure\n")
	check(t, "bad", "bad ?\n")
	check(t, ": bad2 nonesuch ;", "nonesuch ?\n")
	check(t, "bad2", "bad2 ?\n")
	check(t, ": ok1 1 ; ok1 .", "1 ")
	check(t, ": t6 THEN ;", "error: unbalanced control structure\n")
	check(t, ": t7 LEAVE ;", "error: LEAVE outside a loop\n")
}

// TestEncoder holds what the compiler makes of its templates to what
// flexspin's assembler makes of the same instructions.
func TestEncoder(t *testing.T) {
	r := engRefs()
	at := cp
	emitAbs(tCall, 0x12344)
	emitAbs(tJmp, 0x1f000)
	emitAbs(tJz, 0x40000)
	emitAbs(tJnz, 0x7fffc)
	emitAbs(tJnc, 0x400)
	emitImm(tLit, 0x12345)
	emitImm(tNlit, 5)
	emitImm(tFoldPlus, 100000)
	emitImm(int(tFold[primTpl("@")]), 0x7fff0)
	emitImm(int(tFold[primTpl("PIN-HIGH")]), 600)
	emitImm(tTrap, 300)
	l := cp
	cp += 5
	m := missAt
	missAt = 0x7fff8
	loader(l, 40, 0x12340)
	missAt = m
	l = cp
	cp += 3
	repeat(l, 37)
	emitT(tNop)
	for i := 0; i < cp-at; i++ {
		got := code[at+i]
		want := peek(r + uint32(i)*4)
		if got != want {
			printf("long %d: %08x, flexspin %08x\n", i, got, want)
			t.Fail()
		}
	}
	if cp-at != 26 {
		printf("%d longs, want 26\n", cp-at)
		t.Fail()
	}
	cp = at
}

func contains(got []byte, want string) bool {
	for i := 0; i+len(want) <= len(got); i++ {
		if same(got[i:i+len(want)], want) {
			return true
		}
	}
	return false
}

// checkHas is check for output only part of which is fixed.
func checkHas(t *testing.T, src, want string) { checkContains(t, src, want, true) }

// checkNot is check for output that must not contain want.
func checkNot(t *testing.T, src, want string) { checkContains(t, src, want, false) }

func checkContains(t *testing.T, src, want string, has bool) {
	ResetOutput()
	Evaluate(src)
	got := Output()
	if contains(got, want) != has {
		printf("%s\n   got: \"", src)
		show(got)
		if has {
			printf("\"\n  want it to contain: \"%s\"\n", want)
		} else {
			printf("\"\n  want it not to contain: \"%s\"\n", want)
		}
		t.Fail()
	}
	if d := depth(); d != 0 {
		printf("%s\n  left %d on the stack\n", src, d)
		t.Fail()
		reset()
	}
}

func TestDefining(t *testing.T) {
	check(t, ": CONST CREATE , DOES> @ ; 7 CONST seven seven . : u1 seven 1+ ; u1 .", "7 8 ")
	check(t, ": ARRAY CREATE CELLS ALLOT DOES> SWAP CELLS + ; 5 ARRAY ar 42 3 ar ! 3 ar @ .", "42 ")
	check(t, "' seven EXECUTE .", "7 ")
	check(t, "CREATE cr1 99 , ' cr1 >BODY @ .", "99 ")
	check(t, "5 VALUE vv vv . 7 TO vv vv . : t14 9 TO vv ; t14 vv . : t15 vv 1+ ; t15 .", "5 7 9 10 ")
	check(t, "' vv EXECUTE .", "9 ")
	check(t, "DEFER df ' DUP IS df 3 df . . : t16 ['] 1+ IS df ; t16 3 df . ACTION-OF df ' 1+ = .", "3 3 4 -1 ")
	check(t, ": t18 df ; 5 t18 .", "6 ")
	check(t, ":NONAME 2 * ; 21 SWAP EXECUTE .", "42 ")
	check(t, "16 BUFFER: bf bf 16 65 FILL bf 15 + C@ .", "65 ")
	check(t, ": my-if POSTPONE IF ; IMMEDIATE : t8 my-if 1 ELSE 2 THEN ; TRUE t8 . FALSE t8 .", "1 2 ")
	check(t, ": cdup POSTPONE DUP ; IMMEDIATE : t9 cdup * ; 6 t9 .", "36 ")
	check(t, ": c2 ['] DUP COMPILE, ; IMMEDIATE : t10 c2 + ; 4 t10 .", "8 ")
	check(t, ": cs CASE 1 OF 10 ENDOF 2 OF 20 ENDOF 99 SWAP ENDCASE ; 1 cs . 2 cs . 3 cs .", "10 20 99 ")
	check(t, ": d1 DOES> @ 1+ ; : d2 DOES> @ 2 + ; CREATE c3 1 , d1 c3 . d2 c3 .", "2 3 ")
	check(t, ": WEIRD: CREATE DOES> 1+ DOES> 2 + ; WEIRD: w2 ' w2 >BODY w2 SWAP - . ' w2 >BODY w2 SWAP - .", "1 2 ")
}

func TestPictured(t *testing.T) {
	check(t, "<# 123 0 #S #> TYPE", "123")
	check(t, ": .d DUP ABS 0 <# #S ROT SIGN #> TYPE ; -45 .d 0 .d", "-450")
	check(t, "HEX <# $FF 0 # # #> TYPE DECIMAL", "FF")
	check(t, "<# 5 0 # 36 HOLD #> TYPE", "$5")
	check(t, "<# 0 0 #S S\" ab\" HOLDS #> TYPE", "ab0")
	check(t, "-5 S>D . .", "-1 -5 ")
}

func TestInput(t *testing.T) {
	check(t, "S\" 2 3 +\" EVALUATE .", "5 ")
	check(t, ": ev S\" 10 20 *\" EVALUATE ; ev .", "200 ")
	check(t, "S\" : evd 77 ;\" EVALUATE evd .", "77 ")
	check(t, "SOURCE NIP .", "12 ")
	check(t, "SOURCE-ID . S\" SOURCE-ID .\" EVALUATE", "0 -1 ")
	check(t, ": t11 BL WORD COUNT TYPE ; t11 hello", "hello")
	check(t, "BL WORD DUP FIND . DROP", "-1 ")
	check(t, "BL WORD IF FIND . DROP", "1 ")
	check(t, "0 0 S\" 123x\" >NUMBER . DROP . .", "1 0 123 ")
	check(t, ": t12 [CHAR] ) PARSE TYPE ; t12 abc)", "abc")
	check(t, "PARSE-NAME foo TYPE", "foo")
	check(t, ": t13 ABORT\" boom\" 1 ; 0 t13 . 1 t13", "1 boom\n")
	check(t, "S\" X\" ENVIRONMENT? .", "0 ")
	check(t, "1 2 QUIT 3", "")
	check(t, "REFILL .", "0 ")
	check(t, "1 2 3 4 3 ROLL . . . .", "1 4 3 2 ")
	check(t, "CREATE eb 4 ALLOT eb 4 255 FILL eb 2 ERASE eb C@ . eb 3 + C@ .", "0 255 ")
	check(t, ": t17 C\" abc\" COUNT TYPE ; t17", "abc")
	check(t, "UNUSED 0> . PAD 0= .", "-1 0 ")
}

func TestSee(t *testing.T) {
	checkHas(t, ": sq3 DUP * ; SEE sq3", "sq3 is a colon definition\n")
	checkHas(t, "SEE sq3", "  DUP ")
	checkHas(t, "SEE sq3", "  * ")
	checkHas(t, "SEE sq3", "  EXIT ")
	checkHas(t, ": t19 5 + 100000 sq3 . ; SEE t19", "  5 + ")
	checkHas(t, "SEE t19", "  100000 ")
	checkHas(t, "SEE t19", "  DUP ") // sq3, inlined
	checkHas(t, "SEE t19", "  . ")
	checkHas(t, ": t20 0 DO I LOOP ; SEE t20", "  LOOP ")
	checkHas(t, "SEE seven", "seven pushes ")
	checkHas(t, "SEE DUP", "DUP is a primitive\n")
}

// TestRecovery holds an error's recovery to leaving the system as it was:
// a THEN with no IF once patched the first long of DUP.
func TestRecovery(t *testing.T) {
	check(t, ": t21 THEN ; : t22 1 LOOP ; : t23 UNTIL ; : t24 ENDOF ;", "error: unbalanced control structure\n")
	check(t, ": t22 REPEAT ;", "error: unbalanced control structure\n")
	check(t, ": t23 1 LOOP ;", "error: unbalanced control structure\n")
	check(t, ": t24 ENDCASE ;", "error: unbalanced control structure\n")
	check(t, "3 DUP . . 1 2 SWAP . .", "3 3 1 2 ")
}

func TestCoreExt(t *testing.T) {
	check(t, "MARKER mk : gone 1 ; gone . mk gone", "1 gone ?\n")
	check(t, "HERE MARKER mk2 5 ALLOT mk2 HERE = .", "-1 ")
	check(t, "DEFER dd ' DUP ' dd DEFER! 2 dd . . ' dd DEFER@ ' DUP = .", "2 2 -1 ")
	check(t, "S\\\" a\\tb\\x41\\q\" TYPE", "a\tbA\"")
	check(t, ": t25 S\\\" x\\ny\" TYPE ; t25", "x\ny")
	check(t, "VARIABLE si 0 si ! : si1 si @ >IN +! 15 si ! ; S\" SAVE-INPUT si1 RESTORE-INPUT 12345\" EVALUATE si @ . . .", "15 2345 0 ")
}

func TestRecursiveDP(t *testing.T) {
	check(t, ": cd RECURSIVE DUP IF 1- cd THEN ; 5 cd .", "0 ")
	check(t, "HERE 100 ALLOT DP @ SWAP - .", "100 ")
	check(t, "HERE DUP 8 ALLOT DP ! HERE = .", "-1 ")
}

// keys is what testKey answers, as a console would, a CR when it is spent.
var (
	keys  string
	nkeys int
)

func testKey() int {
	if nkeys >= len(keys) {
		return '\r'
	}
	c := keys[nkeys]
	nkeys++
	return int(c)
}

// TestTabs holds the REPL's line reader to taking a TAB for a space, as
// pasted source has them: it once dropped them, gluing words together.
func TestTabs(t *testing.T) {
	keys = ":\ttab1\t2\t3 + ;\t\\ a comment\r"
	nkeys = 0
	Key = testKey
	ntib = accept(uint32(uintptr(unsafe.Pointer(&tib[0]))), len(tib))
	Key = nil
	if !line() {
		printf("the line with TABs failed\n")
		t.Fail()
	}
	check(t, "tab1 .", "5 ")
}

// TestTailInline holds the two cheapest of M4's: a small word without calls
// or branches is copied into its callers, and a definition that ends in a
// call jumps to it, so that a tail recursion runs in a frame of its own.
func TestTailInline(t *testing.T) {
	check(t, ": ti1 DUP * ; : ti2 ti1 1+ ; 3 ti2 .", "10 ")
	checkHas(t, "SEE ti2", "  * ")
	check(t, ": ti3 2 ; : ti4 ti3 ti3 + ; ti4 .", "4 ")
	check(t, ": tc RECURSIVE DUP 0= IF EXIT THEN 1- tc ; 100000 tc .", "0 ")
	checkHas(t, "SEE tc", "TAIL tc")
	check(t, ": tcb .\" x\" ; : tcc 1 DROP tcb ; tcc", "x")
	checkHas(t, "SEE tcc", "TAIL tcb")
	check(t, ": tcd IF 1 ELSE tcb THEN ; 0 tcd 1 tcd .", "x1 ")
	check(t, ": tr1 >R R> ; : tr2 5 tr1 ; tr2 .", "5 ")
	check(t, ": te ; : te2 te te 7 ; te2 .", "7 ")
	checkHas(t, "SEE te2", "  7 ")
	checkHas(t, "SEE tr2", "  TAIL tr1") // not inlined: it uses the return stack
}

// TestFill holds FILL, PASM since M4, at every alignment and length that
// takes each of its three parts.
func TestFill(t *testing.T) {
	check(t, "CREATE fb 32 ALLOT fb 32 0 FILL fb 1+ 9 65 FILL fb 12 TYPE", "\x00AAAAAAAAA\x00\x00")
	check(t, "fb 32 0 FILL fb 3 + 1 66 FILL fb 2 + C@ . fb 3 + C@ . fb 4 + C@ .", "0 66 0 ")
	check(t, "fb 32 0 FILL fb 8 67 FILL fb 7 + C@ . fb 8 + C@ .", "67 0 ")
	check(t, "fb 32 0 FILL fb 0 67 FILL fb C@ .", "0 ")
	check(t, ": ff fb 2 + 13 68 FILL ; ff fb 1+ C@ . fb 2 + C@ . fb 14 + C@ . fb 15 + C@ .", "0 68 68 0 ")
}

// TestCache holds the loops the cog RAM cache runs to what they compute in
// hub RAM, and SEE to showing which ran from where.
func TestCache(t *testing.T) {
	check(t, ": ca1 0 10 0 DO I + LOOP ; ca1 .", "45 ")
	checkHas(t, "SEE ca1", "CACHE ")
	checkHas(t, "SEE ca1", "LOOP cog ")
	check(t, ": ca2 0 BEGIN 1+ DUP 100 = UNTIL ; ca2 .", "100 ")
	check(t, ": ca3 0 BEGIN DUP 5 < WHILE 1+ REPEAT ; ca3 .", "5 ")
	check(t, ": ca4 0 3 0 DO 4 0 DO I J * + LOOP LOOP ; ca4 .", "18 ")
	check(t, ": ca5 0 10 0 DO I 5 = IF LEAVE THEN I + LOOP ; ca5 .", "10 ")
	check(t, ": ca6 0 0 ?DO 1+ LOOP ; 7 ca6 .", "7 ")
	check(t, ": ca7 10 0 DO I 3 = IF I UNLOOP EXIT THEN LOOP 99 ; ca7 .", "3 ")
	check(t, ": ca8 3 0 DO I . LOOP ; ca8", "0 1 2 ")
	check(t, ": ca9 0 3 0 DO 5 0 DO 1+ LOOP I . LOOP ; ca9 .", "0 1 2 15 ")
	check(t, ": ca10 0 BEGIN 1+ DUP 3 > IF EXIT THEN AGAIN ; ca10 .", "4 ")
	check(t, ": ca11 0 20 0 DO I 2 MOD IF I + ELSE 1+ THEN 2 +LOOP ; ca11 .", "10 ")
	check(t, ": ca12 CASE 1 OF 10 ENDOF 20 SWAP ENDCASE ; : ca13 0 4 0 DO I ca12 + LOOP ; ca13 .", "70 ")
	check(t, "CREATE cbuf 100 ALLOT : ca14 cbuf 100 7 FILL 0 100 0 DO cbuf I + C@ + LOOP ; ca14 .", "700 ")
	// A word with the return stack's words is called, not inlined, so the
	// loops around cnc are not cached and the loops inside them are: entered
	// again, one finds itself in cog RAM, two take turns there, and a called
	// word's loop takes it between.
	check(t, ": cnc >R R> 1+ ; : ca15 0 5 0 DO cnc 4 0 DO 1+ LOOP LOOP ; ca15 .", "25 ")
	check(t, ": ca16 0 3 0 DO cnc 2 0 DO 1+ LOOP 3 0 DO 2 + LOOP LOOP ; ca16 .", "27 ")
	check(t, ": cin 0 4 0 DO 1+ LOOP ; : ca17 0 3 0 DO cin + 2 0 DO 10 + LOOP LOOP ; ca17 .", "72 ")
	// A loop longer than cog RAM takes runs from hub RAM.
	check(t, ": 1s 0 ?DO POSTPONE 1+ LOOP ; IMMEDIATE : ca18 0 3 0 DO [ 250 ] 1s LOOP ; ca18 .", "750 ")
	checkNot(t, "SEE ca18", "CACHE ")
	// A loop not cached loses its reservations, and so does one inside a
	// cached loop, moving what branches to and from them.
	checkNot(t, "SEE ca18", "NOP")
	checkNot(t, "SEE ca15", "NOP")
	check(t, ": ca19 0 SWAP 0 ?DO cnc LOOP ; 0 ca19 . 3 ca19 .", "0 3 ")
	check(t, ": ca20 DUP IF 1+ THEN BEGIN cnc DUP 10 > UNTIL ; 0 ca20 . 5 ca20 .", "11 11 ")
	check(t, ": ca21 0 10 0 DO cnc I 5 = IF LEAVE THEN LOOP ; ca21 .", "6 ")
	check(t, ": ca22 0 BEGIN DUP 10 < WHILE 1+ DUP 7 <> WHILE cnc REPEAT THEN ; ca22 .", "7 ")
	check(t, ": ca23 0 BEGIN DUP 10 < WHILE 1+ DUP 70 <> WHILE 1+ REPEAT THEN ; ca23 .", "10 ")
	check(t, ": ca24 0 3 0 DO 4 0 DO 1+ LOOP LOOP ; ca24 .", "12 ")
	checkNot(t, "SEE ca24", "NOP")
	check(t, ": ca25 0 BEGIN BEGIN 1+ DUP 3 MOD 0= UNTIL cnc DUP 20 > UNTIL ; ca25 .", "22 ")
	check(t, ": ca26 0 4 0 DO I 2 MOD IF cnc ELSE 5 0 DO 1+ LOOP THEN LOOP ; ca26 .", "12 ")
	check(t, ": ca27 0 3 0 DO cnc BEGIN 1+ DUP 7 MOD 0= UNTIL LOOP ; ca27 .", "21 ")
	// DOES> code's loops are cached too.
	check(t, ": sumd CREATE , DOES> @ 0 SWAP 0 DO I + LOOP ; 10 sumd s10 s10 .", "45 ")
	checkHas(t, "SEE sumd", "CACHE ")
}

// A DO LOOP in cog RAM with no branch, call or trap in its body repeats the
// body by REP.
func TestRep(t *testing.T) {
	check(t, ": re1 0 10 0 DO I + LOOP ; re1 .", "45 ")
	checkHas(t, "SEE re1", "REP ")
	checkHas(t, "SEE re1", "LOOP cog ")
	check(t, ": re2 0 SWAP 0 ?DO 1+ LOOP ; 0 re2 . 1 re2 . 7 re2 .", "0 1 7 ")
	check(t, ": re3 0 -3 -10 DO 1+ LOOP ; re3 .", "7 ")
	check(t, ": re4 0 5 0 DO I I * + LOOP ; re4 .", "30 ")
	check(t, ": re5 0 3 0 DO 4 0 DO I J + + LOOP LOOP ; re5 .", "30 ")
	checkHas(t, "SEE re5", "REP ")
	check(t, ": re6 10 0 DO I LOOP ; re6 + + + + + + + + + .", "45 ")
	check(t, ": re7 0 100000 0 DO 1+ LOOP ; re7 .", "100000 ")
	checkHas(t, "SEE re7", "REP ")
	// And not otherwise.
	check(t, ": rn1 0 10 0 DO I 1 AND IF 1+ THEN LOOP ; rn1 .", "5 ")
	checkNot(t, "SEE rn1", "REP ")
	check(t, ": rn2 0 10 0 DO 1+ 2 +LOOP ; rn2 .", "5 ")
	checkNot(t, "SEE rn2", "REP ")
	checkNot(t, "SEE rn2", "NOP")
	check(t, "CREATE rbuf 8 ALLOT : rn3 3 0 DO rbuf 8 I FILL LOOP ; rn3 rbuf C@ . rbuf 7 + C@ .", "2 2 ")
	checkNot(t, "SEE rn3", "REP ")
	check(t, ": rn4 10 0 DO I UNLOOP EXIT LOOP ; rn4 .", "0 ")
	checkNot(t, "SEE rn4", "REP ")
	check(t, ": rcall >R R> 1+ ; : rn5 0 5 0 DO rcall LOOP ; rn5 .", "5 ")
	checkNot(t, "SEE rn5", "REP ")
	checkNot(t, "SEE rn5", "NOP")
	check(t, ": rn6 0 10 0 DO 1+ DUP 5 = IF LEAVE THEN LOOP ; rn6 .", "5 ")
	checkNot(t, "SEE rn6", "REP ")
}

// TestP2 holds the P2 words to what the p2 package's functions do, on the
// P2-EDGE's LED pins P56 and P57, which nothing else drives.
func TestP2(t *testing.T) {
	check(t, "CLOCK-FREQ .", "160000000 ")
	check(t, "56 PIN-HIGH 56 PIN-IN . 56 PIN-LOW 56 PIN-IN . 56 PIN-TOGGLE 56 PIN-IN . 56 PIN-FLOAT", "1 0 1 ")
	// Compiled, a literal pin folds into the instruction, and a pin's input
	// follows its output a few clocks late: DRVL #56 and TESTP #56 one after
	// the other read the pin as it was before.
	check(t, ": tp1 56 PIN-HIGH 10 WAIT-CYCLES 56 PIN-IN 56 PIN-LOW 10 WAIT-CYCLES 56 PIN-IN 56 PIN-TOGGLE 10 WAIT-CYCLES 56 PIN-IN 56 PIN-FLOAT ; tp1 . . .", "1 0 1 ")
	checkHas(t, "SEE tp1", "  56 PIN-TOGGLE ")
	check(t, ": tp2 DUP PIN-HIGH PIN-IN ; 57 tp2 . 57 PIN-FLOAT", "1 ")
	check(t, "56 1 PIN-WRITE 56 PIN-IN . 56 0 PIN-WRITE 56 PIN-IN . 56 PIN-FLOAT", "1 0 ")
	check(t, "56 1 6 LSHIFT OR DUP PIN-HIGH 57 PIN-IN . PIN-FLOAT", "1 ")
	check(t, ": tp3 600 PIN-HIGH 56 PIN-IN ;", "")
	checkHas(t, "SEE tp3", "  600 PIN-HIGH ")
	checkHas(t, "SEE tp3", "  56 PIN-IN ")
	// A smart pin as a long repository, which keeps what WXPIN wrote.
	check(t, "57 2 0 0 PIN-START 57 99 WRITE-PIN-X 57 READ-PIN . 57 ACK-PIN", "99 ")
	check(t, ": tp4 57 READ-PIN 57 ACK-PIN ; tp4 . 57 PIN-FLOAT 57 0 WRITE-PIN-MODE", "99 ")
	// The clocks.
	check(t, ": tw1 GET-MS 100 WAIT-MS GET-MS SWAP - ; tw1 DUP 99 > SWAP 102 < AND .", "-1 ")
	check(t, ": tw2 GET-MS 1200 WAIT-MS GET-MS SWAP - ; tw2 DUP 1199 > SWAP 1202 < AND .", "-1 ")
	check(t, ": tw3 GET-MS 0 WAIT-MS -5 WAIT-MS GET-MS SWAP - ; tw3 2 < .", "-1 ")
	check(t, ": tw4 GET-US 1000 WAIT-US GET-US SWAP - ; tw4 DUP 999 > SWAP 1010 < AND .", "-1 ")
	check(t, ": tw5 GET-US 1 WAIT-US GET-US SWAP - ; tw5 20 < .", "-1 ")
	check(t, ": tw6 GET-CT 1000 WAIT-CYCLES GET-CT SWAP - ; tw6 DUP 999 > SWAP 1020 < AND .", "-1 ")
	check(t, ": tw7 GET-CT 100000 + DUP WAIT-UNTIL GET-CT SWAP - ; tw7 DUP -1 > SWAP 30 < AND .", "-1 ")
	check(t, "GET-SEC GET-MS 1000 / - ABS 2 < . GET-US 1000 / GET-MS - ABS 2 < .", "-1 -1 ")
	// WAIT-MS branches, so a loop with it is cached and not repeated by REP;
	// WAIT-CYCLES does not.
	check(t, ": tw8 GET-MS 3 0 DO 2 WAIT-MS LOOP GET-MS SWAP - ; tw8 DUP 5 > SWAP 8 < AND .", "-1 ")
	checkHas(t, "SEE tw8", "CACHE ")
	checkNot(t, "SEE tw8", "REP ")
	check(t, ": tw9 GET-CT 10 0 DO 100 WAIT-CYCLES LOOP GET-CT SWAP - ; tw9 DUP 1000 > SWAP 1200 < AND .", "-1 ")
	checkHas(t, "SEE tw9", "REP ")
	// The rest.
	check(t, "RND RND <> . 1 REV $80000000 = . 5 1234 WRITE-LUT 5 READ-LUT . COG-ID 8 < .", "-1 -1 1234 -1 ")
	check(t, "NEW-LOCK DUP 0< . DUP TRY-LOCK . DUP UNLOCK FREE-LOCK", "0 -1 ")
	check(t, ": grab 20 0 DO NEW-LOCK DUP 0< IF DROP LEAVE THEN LOOP ; : free DEPTH 0 ?DO FREE-LOCK LOOP ;", "")
	check(t, ": tl grab DEPTH DUP 0> SWAP 17 < AND >R free R> ; tl . NEW-LOCK DUP 0< . FREE-LOCK", "-1 0 ")
}

// TestRun holds RUN to running a word on a cog of its own, with the cells it
// is given, to freeing the cog when the word returns, and to refusing a word
// that calls OctoGo.
func TestRun(t *testing.T) {
	check(t, "VARIABLE rv : r1 rv ! ; 42 1 ' r1 RUN 0< . 1 WAIT-MS rv @ .", "0 42 ")
	check(t, ": r2 + rv ! ; 3 4 2 ' r2 RUN DROP 1 WAIT-MS rv @ .", "7 ")
	// A loop, cached in the other cog's RAM, until COG-STOP.
	check(t, ": r3 BEGIN 1 rv +! AGAIN ; 0 rv ! 0 ' r3 RUN 1 WAIT-MS COG-STOP rv @ DUP 0> . 1 WAIT-MS rv @ = .", "-1 -1 ")
	checkHas(t, "SEE r3", "CACHE ")
	// The cog is free again when the word returns.
	check(t, ": r4 ; : r5 0 20 0 DO 0 ['] r4 RUN 0< OR 1 WAIT-MS LOOP ; r5 .", "0 ")
	// Every free cog, and then -1.
	check(t, ": r6 BEGIN AGAIN ; : r7 BEGIN 0 ['] r6 RUN DUP 0< UNTIL DROP ; : r8 DEPTH 0 ?DO COG-STOP LOOP ;", "")
	check(t, ": r9 r7 DEPTH DUP 0> SWAP 8 < AND >R r8 R> ; r9 . 0 ' r4 RUN 0< .", "-1 0 ")
	// A pin the other cog drives, which it lets go when it stops.
	check(t, ": r10 PIN-HIGH BEGIN AGAIN ; 57 1 ' r10 RUN 1 WAIT-MS 57 PIN-IN . COG-STOP", "1 ")
	// A word that calls OctoGo is not run.
	check(t, ": r11 1 . ; 0 ' r11 RUN", "r11 calls OctoGo, which only this cog runs\n")
	check(t, ": r12 2 r11 ; 0 ' r12 RUN", "r12 calls OctoGo, which only this cog runs\n")
	check(t, "0 ' . RUN", ". calls OctoGo, which only this cog runs\n")
	check(t, "17 ' r1 RUN", "error: RUN takes at most 16 cells\n")
	check(t, "1 ' r1 RUN", "error: stack underflow\n")
}

func addMul() {
	b := Pop()
	a := Pop()
	Push(a + b)
	Push(a * b)
}

// TestDefine holds Define, Push and Pop to making a function of the program
// a word, executed and compiled, the cells it takes checked first.
func TestDefine(t *testing.T) {
	if !Define("ADD-MUL", 2, addMul) {
		printf("Define failed\n")
		t.Fail()
	}
	if Define("", 0, addMul) {
		printf("Define took an empty name\n")
		t.Fail()
	}
	check(t, "3 4 ADD-MUL . .", "12 7 ")
	check(t, ": am 1+ ADD-MUL ; 5 5 am . .", "30 11 ")
	check(t, "1 ADD-MUL", "error: stack underflow\n")
	check(t, "0 ' am RUN", "am calls OctoGo, which only this cog runs\n")
	checkHas(t, "SEE ADD-MUL", "ADD-MUL is OctoGo's, trap ")
}

// TestException holds CATCH and THROW to the EXCEPTION word set: the stacks
// put back after a THROW, the system's errors given ANS's codes, ABORT"'s
// message written only when nothing catches it.
func TestException(t *testing.T) {
	check(t, ": x1 9 ; : c1 1 2 3 ['] x1 CATCH ; c1 . . . . .", "0 9 3 2 1 ")
	check(t, ": x2 7 8 9 99 THROW ; : c2 1 2 ['] x2 CATCH ; c2 . . .", "99 2 1 ")
	check(t, ": x3 1- DUP 0> IF RECURSE ELSE 999 THROW -222 THEN ; : c3 3 4 5 10 ['] x3 CATCH -111 ; c3 . . . . . .", "-111 999 0 5 4 3 ")
	check(t, "1 2 ' ABORT CATCH . . .", "-1 2 1 ")
	check(t, ": x4 77 SWAP ABORT\" not shown\" ; 4 5 ' x4 CATCH . . .", "-2 77 4 ")
	check(t, "0 ' x4 CATCH . .", "0 77 ")
	check(t, "S\" 1 undefined-word 2\" ' EVALUATE CATCH . DEPTH . 2DROP", "-13 2 ")
	check(t, "' . CATCH .", "-4 ")
	check(t, "1 1 0 ' */ CATCH . DEPTH . 2DROP DROP", "-10 3 ")
	check(t, "0 THROW 5 .", "5 ")
	// Uncaught, a THROW says so, and ABORT" writes its message.
	check(t, "42 THROW", "error: uncaught THROW 42\n")
	check(t, ": x6 ABORT\" boom\" ; 1 x6", "boom\n")
	// A definition begun inside the CATCH is taken back, and the line goes on.
	check(t, "S\" : half 1 undefined ;\" ' EVALUATE CATCH . 2DROP 7 .", "-13 7 ")
	check(t, "' half", "half ?\n")
	// QUIT is not caught.
	check(t, ": x7 QUIT ; ' x7 CATCH 5 .", "")
	// A THROW from a loop leaves the loop around the CATCH as it was.
	check(t, ": x8 10 0 DO I 3 = IF 5 THROW THEN LOOP ; : c8 0 3 0 DO ['] x8 CATCH + LOOP ; c8 .", "15 ")
	check(t, ": c9 0 4 0 DO I 2 MOD IF ['] x8 CATCH + ELSE 1+ THEN LOOP ; c9 .", "12 ")
}

// TestDouble holds the DOUBLE word set: numbers ending in a point, the
// templates' arithmetic, the defining words, M*/, D. and D.R.
func TestDouble(t *testing.T) {
	check(t, "1. . . -2. . .", "0 1 -1 -2 ")
	check(t, ": rd 3. ; rd D. $-12AbCdEf. D. #-12346789. D.", "3 -313249263 -12346789 ")
	check(t, "1 2 2CONSTANT c2 c2 . . : uc2 c2 ; uc2 . .", "2 1 2 1 ")
	checkHas(t, "SEE c2", "c2 pushes 1 2")
	check(t, "2VARIABLE v2 5 6 v2 2! v2 2@ . .", "6 5 ")
	check(t, "7 8 2VALUE w2 w2 . . 9 10 TO w2 w2 . . : tw 11 12 TO w2 ; tw w2 . .", "8 7 10 9 12 11 ")
	checkHas(t, "SEE w2", "w2 is a 2VALUE, now 11 12")
	check(t, ": cl [ 3 4 ] 2LITERAL ; cl . .", "4 3 ")
	check(t, "1. 2. D+ D. -1. 2. D+ D. 5. 7. D- D. -1 0 1 0 D+ . .", "3 1 -2 1 0 ")
	check(t, "1. DNEGATE D. -5. DABS D. 0 1 D2/ . . -1. D2* D.", "-1 5 0 -2147483648 -2 ")
	check(t, "-1. D0< . 0. D0= . 1. 2. D< . -2. -1. D< . 1. -1. DU< . 3. 3. D= .", "-1 -1 -1 -1 -1 -1 ")
	check(t, "1. 2. DMAX D. 1. 2. DMIN D. -1. 3 M+ D. 7. D>S .", "2 1 2 7 ")
	check(t, "1. 2. 3. 2ROT D. D. D.", "1 3 2 ")
	check(t, "5. 7 11 M*/ D. -5. 7 11 M*/ D. 4611686018427387903. 8 16 M*/ D.", "3 -3 2305843009213693951 ")
	check(t, "12345. 10 D.R -1. 4 D.R", "     12345  -1")
}

// TestString holds the STRING word set.
func TestString(t *testing.T) {
	check(t, "S\" ab  \" -TRAILING . DROP S\"    \" -TRAILING . DROP", "2 0 ")
	check(t, "CREATE sb 8 ALLOT sb 8 BLANK sb 8 TYPE", "        ")
	check(t, "S\" abcdef\" sb SWAP CMOVE sb sb 1+ 3 CMOVE sb 6 TYPE", "aaaaef")
	check(t, "S\" abcdef\" sb SWAP CMOVE sb 1+ sb 3 CMOVE> sb 6 TYPE", "ddddef")
	check(t, "S\" abc\" S\" abd\" COMPARE . S\" abc\" S\" abc\" COMPARE . S\" abcd\" S\" abc\" COMPARE . S\" B\" S\" a\" COMPARE .", "-1 0 1 -1 ")
	check(t, "S\" hello world\" S\" wor\" SEARCH . TYPE", "-1 world")
	check(t, "S\" hello\" S\" xyz\" SEARCH . TYPE", "0 hello")
	check(t, ": sl [ S\" lit\" ] SLITERAL ; sl TYPE", "lit")
	check(t, "S\" a%b\" PAD UNESCAPE TYPE", "a%%b")
	check(t, "S\" xy\" S\" n\" REPLACES S\" 1%n%2%%3%m%\" PAD 40 SUBSTITUTE . TYPE", "1 1xy2%3%m%")
	check(t, "S\" abcd\" PAD 3 SUBSTITUTE . 2DROP", "-1 ")
	check(t, "S\" Q\" S\" N\" REPLACES S\" %n%\" PAD 9 SUBSTITUTE . TYPE", "1 Q")
}

// The host's files for TestInclude and TestFile: a 9P server in the test,
// which reads the messages the client writes into out, takes them out of
// it, and answers by Key, as the loader does over the serial line. Its
// messages are shorter than the client's, so that reads and writes are cut
// to its size. One file can be written, hostW.
type hostFile struct {
	name string
	text string
}

const hostMsize = 512

var (
	hostFiles = [...]hostFile{
		{"a.fth", ": ia 1 2 + ;\nia .\n"},
		{"dir/b.fth", "INCLUDE a.fth\r\n: ib ia 10 * ; ib .\r\n"},
		{"c.fth", "1 .\nnosuch\n3 .\n"},
		{"d.fth", "( a comment\nover lines ) 8 .\nSOURCE-ID 0> .\nREFILL\n7 .\n"},
		{"e.txt", "one\r\ntwo\rthree\nlast"},
		{"big.fth", ""}, // hostBig
		{"r.fth", "1+\n"},
		{"s.fth", "VARIABLE siv -1 siv !\n: ?back siv @ IF 0 siv ! RESTORE-INPUT THEN ;\n11 SAVE-INPUT\n?back\n. .\n"},
	}
	hostBig   [1200]byte
	nbig      int
	hostFid   [16]int // the file a fid stands for, -1 for none, -2 the root
	hostOut   [hostMsize]byte
	nhost     int
	phost     int
	hostSays  bool   // whether the host answers at all
	hostTyped string // what is typed before the next reply

	hostWName  [16]byte
	nhostWName int
	hostW      [640]byte
	nhostW     int
	hostWUsed  bool
)

const hostWFile = 100 // what hostFid has for hostW

// hostRead copies n bytes of the file i from off into the reply.
func hostRead(i, off, n int) {
	for k := off; k < off+n; k++ {
		if i == hostWFile {
			hostOut[nhost] = hostW[k]
		} else if hostFiles[i].name == "big.fth" {
			hostOut[nhost] = hostBig[k]
		} else {
			hostOut[nhost] = hostFiles[i].text[k]
		}
		nhost++
	}
}

func hostLen(i int) int {
	if i < 0 {
		return 0
	}
	if i == hostWFile {
		return nhostW
	}
	if hostFiles[i].name == "big.fth" {
		return nbig
	}
	return len(hostFiles[i].text)
}

func hostPut(v uint32, n int) {
	for i := 0; i < n; i++ {
		hostOut[nhost] = byte(v >> (8 * i))
		nhost++
	}
}

func hostGet(m []byte, at, n int) uint32 {
	v := uint32(0)
	for i := n - 1; i >= 0; i-- {
		v = v<<8 | uint32(m[at+i])
	}
	return v
}

func hostStr(s string) {
	hostPut(uint32(len(s)), 2)
	for i := 0; i < len(s); i++ {
		hostOut[nhost] = s[i]
		nhost++
	}
}

func hostReply(t byte, tag uint32) {
	nhost = 4
	hostPut(uint32(t), 1)
	hostPut(tag, 2)
}

func hostErr(tag uint32, s string) {
	hostReply(rError, tag)
	hostStr(s)
}

// hostGrow makes hostW n bytes long, as far as it holds.
func hostGrow(n int) {
	for nhostW < n && nhostW < len(hostW) {
		hostW[nhostW] = 0
		nhostW++
	}
	if n < nhostW {
		nhostW = n
	}
}

// hostServe answers the message the client wrote last, if there is one,
// and if the host is to answer at all.
func hostServe() {
	if phost < nhost {
		return
	}
	at := -1
	for i := 0; i+6 <= nout; i++ {
		if out[i] == 0xff && out[i+1] == 1 && i+2+int(hostGet(out[:], i+2, 4)) == nout {
			at = i
			break
		}
	}
	if at < 0 {
		return
	}
	m := out[at+2 : nout]
	nout = at
	if !hostSays {
		return
	}
	tag := hostGet(m, 5, 2)
	switch m[4] {
	case tVersion:
		hostReply(tVersion+1, tag)
		hostPut(hostMsize, 4)
		hostStr("9P2000")
	case tAttach:
		hostFid[hostGet(m, 7, 4)] = -2
		hostReply(tAttach+1, tag)
		hostPut(0, 13)
	case tWalk:
		newfid := hostGet(m, 11, 4)
		nw := int(hostGet(m, 15, 2))
		var name [64]byte
		n := 0
		p := 17
		for i := 0; i < nw; i++ {
			l := int(hostGet(m, p, 2))
			if i > 0 {
				name[n] = '/'
				n++
			}
			n += copy(name[n:], m[p+2:p+2+l])
			p += 2 + l
		}
		f := -1
		if n == 0 {
			f = -2
		}
		if hostWUsed && bytesEq(name[:n], hostWName[:nhostWName]) {
			f = hostWFile
		}
		for i := range hostFiles {
			if same(name[:n], hostFiles[i].name) {
				f = i
			}
		}
		if f == -1 {
			hostErr(tag, "file does not exist")
			break
		}
		hostFid[newfid] = f
		hostReply(tWalk+1, tag)
		hostPut(uint32(nw), 2)
		for j := 0; j < nw; j++ {
			hostPut(0, 13)
		}
	case tOpen:
		if m[11]&oTrunc != 0 && hostFid[hostGet(m, 7, 4)] == hostWFile {
			nhostW = 0
		}
		hostReply(tOpen+1, tag)
		hostPut(0, 13)
		hostPut(0, 4)
	case tCreate:
		if hostWUsed {
			hostErr(tag, "file exists")
			break
		}
		l := int(hostGet(m, 11, 2))
		nhostWName = copy(hostWName[:], m[13:13+l])
		nhostW = 0
		hostWUsed = true
		hostFid[hostGet(m, 7, 4)] = hostWFile
		hostReply(tCreate+1, tag)
		hostPut(0, 13)
		hostPut(0, 4)
	case tWrite:
		if hostFid[hostGet(m, 7, 4)] != hostWFile {
			hostErr(tag, "permission denied")
			break
		}
		off := int(hostGet(m, 11, 4))
		n := int(hostGet(m, 19, 4))
		if off+n > nhostW {
			hostGrow(off + n)
		}
		copy(hostW[off:nhostW], m[23:23+n])
		hostReply(tWrite+1, tag)
		hostPut(uint32(n), 4)
	case tRemove:
		fid := hostGet(m, 7, 4)
		if hostFid[fid] != hostWFile {
			hostFid[fid] = -1
			hostErr(tag, "permission denied")
			break
		}
		hostFid[fid] = -1
		hostWUsed = false
		hostReply(tRemove+1, tag)
	case tStat:
		i := hostFid[hostGet(m, 7, 4)]
		hostReply(tStat+1, tag)
		hostPut(49, 2) // nstat, then the stat's size, type, dev and qid
		hostPut(47, 2)
		hostPut(0, 2+4+13)
		mode := uint32(0)
		if i == -2 {
			mode = dmDir
		}
		hostPut(mode, 4)
		hostPut(0, 8) // atime, mtime
		hostPut(uint32(hostLen(i)), 4)
		hostPut(0, 4)
		hostPut(0, 8) // name, uid, gid, muid
	case tWstat:
		if hostFid[hostGet(m, 7, 4)] != hostWFile {
			hostErr(tag, "permission denied")
			break
		}
		if l := hostGet(m, 46, 4); l != 0xffffffff {
			hostGrow(int(l))
		}
		if k := int(hostGet(m, 54, 2)); k > 0 {
			nhostWName = copy(hostWName[:], m[56:56+k])
		}
		hostReply(tWstat+1, tag)
	case tRead:
		i := hostFid[hostGet(m, 7, 4)]
		off := int(hostGet(m, 11, 4))
		n := int(hostGet(m, 19, 4))
		if n > hostMsize-11 {
			n = hostMsize - 11
		}
		if off > hostLen(i) {
			off = hostLen(i)
		}
		if off+n > hostLen(i) {
			n = hostLen(i) - off
		}
		hostReply(tRead+1, tag)
		hostPut(uint32(n), 4)
		hostRead(i, off, n)
	case tClunk:
		hostFid[hostGet(m, 7, 4)] = -1
		hostReply(tClunk+1, tag)
	}
	phost = 0
	nh := nhost
	nhost = 0
	hostPut(uint32(nh), 4)
	nhost = nh
	if k := len(hostTyped); k > 0 {
		for i := nhost - 1; i >= 0; i-- {
			hostOut[i+k] = hostOut[i]
		}
		for i := 0; i < k; i++ {
			hostOut[i] = hostTyped[i]
		}
		nhost += k
		hostTyped = ""
	}
}

func hostAvail() bool {
	hostServe()
	return phost < nhost
}

func hostKey() int {
	hostServe()
	if phost < nhost {
		c := hostOut[phost]
		phost++
		return int(c)
	}
	return '\r'
}

// hostOpen answers how many fids stand for files.
func hostOpen() int {
	n := 0
	for _, f := range hostFid {
		if f >= 0 {
			n++
		}
	}
	return n
}

// hostUp makes the host the file server, its fids all free.
func hostUp() {
	for i := range hostFid {
		hostFid[i] = -1
	}
	Key = hostKey
	Avail = hostAvail
	hostSays = true
	nineUp = false
}

func TestInclude(t *testing.T) {
	hostUp()
	hostBig[0] = '0'
	hostBig[1] = '\n'
	nbig = 2
	for nbig+6 <= len(hostBig) {
		hostBig[nbig] = '1'
		hostBig[nbig+1] = '+'
		hostBig[nbig+2] = '\n'
		nbig += 3
	}
	hostBig[nbig] = '.'
	hostBig[nbig+1] = '\n'
	nbig += 2
	check(t, "INCLUDE a.fth ia .", "3 3 ")
	check(t, "S\" dir/b.fth\" INCLUDED", "3 30 ")
	check(t, "INCLUDE c.fth", "1 c.fth:2: nosuch ?\n")
	check(t, "INCLUDE d.fth .", "8 -1 7 -1 ")
	check(t, "INCLUDE nofile.fth", "nofile.fth: file does not exist\n")
	check(t, "INCLUDE big.fth", "398 ")
	check(t, "S\" e.txt\" R/O OPEN-FILE . VALUE fe", "0 ")
	check(t, "PAD 80 fe READ-LINE . . PAD SWAP TYPE", "0 -1 one")
	check(t, "PAD 80 fe READ-LINE . . PAD SWAP TYPE", "0 -1 two")
	check(t, "PAD 2 fe READ-LINE . . PAD SWAP TYPE", "0 -1 th")
	check(t, "PAD 80 fe READ-LINE . . PAD SWAP TYPE", "0 -1 ree")
	check(t, "PAD 80 fe READ-LINE . . PAD SWAP TYPE", "0 -1 last")
	check(t, "PAD 80 fe READ-LINE . . .", "0 0 0 ")
	check(t, "fe CLOSE-FILE .", "0 ")
	check(t, "fe CLOSE-FILE .", "-37 ")
	check(t, "S\" a.fth\" R/O BIN OPEN-FILE DROP VALUE fa PAD 4 fa READ-FILE . . PAD 4 TYPE", "0 4 : ia")
	check(t, "fa CLOSE-FILE .", "0 ")
	check(t, "S\" a.fth\" R/O OPEN-FILE DROP INCLUDE-FILE", "3 ")
	check(t, "S\" nofile.fth\" R/O OPEN-FILE . .", "-38 0 ")
	// What is typed while a reply is on its way comes before it, and is
	// the console's next input.
	hostTyped = "7 6 * .\r"
	check(t, "INCLUDE a.fth", "3 ")
	ResetOutput()
	ntib = accept(uint32(uintptr(unsafe.Pointer(&tib[0]))), len(tib))
	line()
	if got := Output(); !same(got, "7 6 * . 42 ") {
		printf("typed ahead: got \"")
		show(got)
		printf("\"\n")
		t.Fail()
	}
	if n := hostOpen(); n != 0 {
		printf("%d files left open on the host\n", n)
		t.Fail()
	}
	// With no file server.
	hostSays = false
	nineUp = false
	nineWait = 20
	check(t, "INCLUDE a.fth", "a.fth: no file server: load with ogo run -9 DIR\n")
	nineWait = 3000
	Key = nil
	Avail = nil
}

// hostHas checks what the host's file that can be written holds.
func hostHas(t *testing.T, want string) {
	if !same(hostW[:nhostW], want) {
		printf("host's file: got \"")
		show(hostW[:nhostW])
		printf("\", want \"%s\"\n", want)
		t.Fail()
	}
}

func TestFile(t *testing.T) {
	hostUp()
	check(t, "S\" w.txt\" W/O CREATE-FILE . VALUE fw", "0 ")
	check(t, "S\" hello\" fw WRITE-LINE . S\" world\" fw WRITE-FILE . fw FILE-POSITION . . .", "0 0 0 0 11 ")
	check(t, "fw CLOSE-FILE .", "0 ")
	hostHas(t, "hello\nworld")
	check(t, "S\" w.txt\" R/O OPEN-FILE . VALUE fr PAD 80 fr READ-LINE . . PAD SWAP TYPE", "0 0 -1 hello")
	check(t, "fr FILE-SIZE . . . S\" x\" fr WRITE-FILE . fr CLOSE-FILE .", "0 0 11 -37 0 ")
	check(t, "S\" w.txt\" R/W OPEN-FILE . VALUE fb 6 0 fb REPOSITION-FILE . S\" W\" fb WRITE-FILE . 0 0 fb REPOSITION-FILE . PAD 80 fb READ-FILE . PAD SWAP TYPE", "0 0 0 0 0 hello\nWorld")
	check(t, "5 0 fb RESIZE-FILE . fb FILE-SIZE . . . fb FILE-POSITION . . . fb CLOSE-FILE .", "0 0 0 5 0 0 11 0 ")
	hostHas(t, "hello")
	// CREATE-FILE empties a file that is there.
	check(t, "S\" w.txt\" R/W CREATE-FILE . VALUE fc S\" ab\" fc WRITE-FILE . fc FILE-SIZE . . . fc CLOSE-FILE .", "0 0 0 0 2 0 ")
	hostHas(t, "ab")
	check(t, "S\" w.txt\" S\" v.txt\" RENAME-FILE . S\" w.txt\" FILE-STATUS NIP . S\" v.txt\" FILE-STATUS NIP .", "0 -38 0 ")
	check(t, "S\" v.txt\" DELETE-FILE . S\" v.txt\" DELETE-FILE 0= . S\" a.fth\" DELETE-FILE 0= .", "0 0 0 ")
	check(t, "S\" \" DELETE-FILE 0= . S\" dir/..\" DELETE-FILE 0= . S\" dir/b.fth\" S\" b.fth\" RENAME-FILE 0= .", "0 0 0 ")
	// More than a buffer holds, and more than a message.
	check(t, "CREATE wbig 600 ALLOT wbig 600 CHAR x FILL S\" w.txt\" W/O CREATE-FILE . VALUE fd wbig 600 fd WRITE-FILE . fd CLOSE-FILE .", "0 0 0 ")
	if nhostW != 600 || hostW[0] != 'x' || hostW[599] != 'x' {
		printf("host's file: %d bytes\n", nhostW)
		t.Fail()
	}
	check(t, "S\" w.txt\" DELETE-FILE .", "0 ")
	check(t, "0 S\" r.fth\" REQUIRED REQUIRE r.fth INCLUDE r.fth .", "2 ")
	check(t, "INCLUDE s.fth", "0 11 ")
	check(t, "S\" ab\" S\" cd\" TYPE TYPE", "cdab")
	check(t, "S\" abcdef\" 2 /STRING TYPE S\" xy\" 0 /STRING TYPE", "cdefxy")
	if n := hostOpen(); n != 0 {
		printf("%d files left open on the host\n", n)
		t.Fail()
	}
	Key = nil
	Avail = nil
}

// TestCard runs the file words on the SD card in the slot, in files of its
// own, which it deletes. A board with no card in the slot passes, saying
// that nothing was tested.
func TestCard(t *testing.T) {
	if !sdOpen() {
		println("no card in the slot, and nothing tested")
		return
	}
	check(t, "S\" sd:OctoForth Test.text\" DELETE-FILE DROP S\" sd:oftest2.txt\" DELETE-FILE DROP", "")
	check(t, "S\" sd:oftest1.txt\" W/O CREATE-FILE . VALUE cw", "0 ")
	check(t, "S\" hello\" cw WRITE-LINE . S\" world\" cw WRITE-FILE . cw FILE-POSITION . . . cw CLOSE-FILE .", "0 0 0 0 11 0 ")
	check(t, "S\" SD:OFTEST1.TXT\" R/O OPEN-FILE . VALUE cr PAD 80 cr READ-LINE . . PAD SWAP TYPE", "0 0 -1 hello")
	check(t, "cr FILE-SIZE . . . S\" x\" cr WRITE-FILE . cr CLOSE-FILE .", "0 0 11 -37 0 ")
	check(t, "S\" sd:oftest1.txt\" R/W OPEN-FILE . VALUE cb 6 0 cb REPOSITION-FILE . S\" W\" cb WRITE-FILE . 0 0 cb REPOSITION-FILE . PAD 80 cb READ-FILE . PAD SWAP TYPE", "0 0 0 0 0 hello\nWorld")
	check(t, "5 0 cb RESIZE-FILE . cb FILE-SIZE . . . cb FILE-POSITION . . . cb CLOSE-FILE .", "0 0 0 5 0 0 11 0 ")
	check(t, "S\" sd:oftest1.txt\" R/O OPEN-FILE . VALUE cs PAD 80 cs READ-FILE . PAD SWAP TYPE cs CLOSE-FILE .", "0 0 hello0 ")
	// CREATE-FILE empties a file that is there, and frees its clusters.
	check(t, "S\" sd:oftest1.txt\" R/W CREATE-FILE . VALUE cc S\" ab\" cc WRITE-FILE . cc FILE-SIZE . . . cc CLOSE-FILE .", "0 0 0 0 2 0 ")
	// A long name, found regardless of case.
	check(t, "S\" sd:oftest1.txt\" S\" sd:OctoForth Test.text\" RENAME-FILE . S\" sd:oftest1.txt\" FILE-STATUS NIP . S\" sd:octoforth test.TEXT\" FILE-STATUS NIP .", "0 -38 0 ")
	// More than a block and than a cluster of 4 KB, read across a block's end.
	check(t, "CREATE cbig 9000 ALLOT cbig 9000 CHAR q FILL S\" sd:OctoForth Test.text\" W/O CREATE-FILE . VALUE cd cbig 9000 cd WRITE-FILE . cd CLOSE-FILE .", "0 0 0 ")
	check(t, "cbig 9000 ERASE S\" sd:OctoForth Test.text\" R/O OPEN-FILE . VALUE ce 8190 0 ce REPOSITION-FILE . cbig 100 ce READ-FILE . . cbig 99 + C@ EMIT ce FILE-SIZE . . . ce CLOSE-FILE .", "0 0 0 100 q0 0 9000 0 ")
	// Written past its end, a file has zeros up to where it was written.
	check(t, "S\" sd:oftest2.txt\" W/O CREATE-FILE . VALUE cg 600 0 cg REPOSITION-FILE . S\" x\" cg WRITE-FILE . cg FILE-SIZE . . . cg CLOSE-FILE .", "0 0 0 0 0 601 0 ")
	check(t, "S\" sd:oftest2.txt\" R/O OPEN-FILE . VALUE ch cbig 700 ch READ-FILE . . cbig C@ . cbig 600 + C@ EMIT ch CLOSE-FILE .", "0 0 601 0 x0 ")
	// An open file is neither deleted nor opened to be written.
	check(t, "S\" sd:oftest2.txt\" R/O OPEN-FILE . VALUE ci S\" sd:oftest2.txt\" DELETE-FILE 0= . S\" sd:oftest2.txt\" W/O OPEN-FILE NIP 0= . ci CLOSE-FILE .", "0 0 0 0 ")
	check(t, "S\" sd:a*b\" W/O CREATE-FILE NIP 0= . S\" sd:\" R/O OPEN-FILE NIP 0= . S\" sd:nodir/x.txt\" R/O OPEN-FILE . .", "0 0 -38 0 ")
	check(t, "S\" sd:oftest2.txt\" S\" oftest2.txt\" RENAME-FILE 0= . S\" sd:\" DELETE-FILE 0= .", "0 0 ")
	check(t, "S\" sd:oftest2.txt\" DELETE-FILE . S\" sd:OctoForth Test.text\" DELETE-FILE . S\" sd:oftest2.txt\" DELETE-FILE 0= .", "0 0 0 ")
	for f := range files {
		if files[f].open {
			printf("file %d left open\n", f)
			t.Fail()
		}
	}
}

// TestFlash writes files in the board's flash, past the program it boots,
// and deletes them.
func TestFlash(t *testing.T) {
	check(t, "S\" flash:oftest1.txt\" DELETE-FILE DROP S\" flash:oftest2.txt\" DELETE-FILE DROP S\" flash:OctoForth Test.text\" DELETE-FILE DROP", "")
	check(t, "S\" flash:oftest1.txt\" W/O CREATE-FILE . VALUE fw", "0 ")
	check(t, "S\" hello\" fw WRITE-LINE . S\" world\" fw WRITE-FILE . fw FILE-POSITION . . . fw CLOSE-FILE .", "0 0 0 0 11 0 ")
	check(t, "S\" FLASH:OFTEST1.TXT\" R/O OPEN-FILE . VALUE fr PAD 80 fr READ-LINE . . PAD SWAP TYPE", "0 0 -1 hello")
	check(t, "fr FILE-SIZE . . . S\" x\" fr WRITE-FILE . fr CLOSE-FILE .", "0 0 11 -37 0 ")
	// Written as it is made only, at its end: neither opened to be written,
	// resized nor renamed.
	check(t, "S\" flash:oftest1.txt\" R/W OPEN-FILE NIP 0= . S\" flash:oftest1.txt\" S\" flash:oftest2.txt\" RENAME-FILE 0= .", "0 0 ")
	check(t, "S\" flash:oftest2.txt\" R/W CREATE-FILE . VALUE fb S\" abc\" fb WRITE-FILE . fb FLUSH-FILE . 0 0 fb REPOSITION-FILE . PAD 10 fb READ-FILE . . PAD 3 TYPE", "0 0 0 0 0 3 abc")
	check(t, "2 0 fb RESIZE-FILE 0= . 0 0 fb REPOSITION-FILE . S\" x\" fb WRITE-FILE . fb CLOSE-FILE 0= .", "0 0 0 0 ")
	check(t, "S\" flash:oftest2.txt\" R/O OPEN-FILE . VALUE fc fc FILE-SIZE . . . fc CLOSE-FILE .", "0 0 0 3 0 ")
	// CREATE-FILE replaces a file that is there.
	check(t, "S\" flash:oftest2.txt\" W/O CREATE-FILE . VALUE fd S\" de\" fd WRITE-FILE . fd CLOSE-FILE . S\" flash:oftest2.txt\" R/O OPEN-FILE . VALUE fe fe FILE-SIZE . . . fe CLOSE-FILE .", "0 0 0 0 0 0 2 0 ")
	// More than a block of 64 KB, read across the blocks' ends.
	check(t, "CREATE fbig 1000 ALLOT S\" flash:OctoForth Test.text\" W/O CREATE-FILE . VALUE ff : fwr 70 0 DO fbig 1000 I 48 + FILL fbig 1000 ff WRITE-FILE DROP LOOP ; fwr ff CLOSE-FILE .", "0 0 ")
	check(t, "S\" flash:octoforth test.TEXT\" R/O OPEN-FILE . VALUE fg 65400 0 fg REPOSITION-FILE . fbig 16 fg READ-FILE . . fbig 16 TYPE", "0 0 0 16 qqqqqqqqqqqqqqqq")
	check(t, "65990 0 fg REPOSITION-FILE . fbig 20 fg READ-FILE . . fbig 20 TYPE fg FILE-SIZE . . . fg CLOSE-FILE .", "0 0 20 qqqqqqqqqqrrrrrrrrrr0 0 70000 0 ")
	// An open file is neither deleted nor made again.
	check(t, "S\" flash:oftest2.txt\" R/O OPEN-FILE . VALUE fh S\" flash:oftest2.txt\" DELETE-FILE 0= . S\" flash:oftest2.txt\" W/O CREATE-FILE NIP 0= . fh CLOSE-FILE .", "0 0 0 0 ")
	check(t, "S\" flash:\" R/O OPEN-FILE NIP 0= . S\" flash:nosuch\" R/O OPEN-FILE . .", "0 -38 0 ")
	// A file whose size was never written, as one being made when the board
	// was reset, is not there.
	if f := fileOpen([]byte("flash:oftest1.txt"), famWO, true); f < 0 || !fileWrite(f, []byte("lost")) || !fileFlush(f) {
		println("flash:oftest1.txt not made")
		t.Fail()
	} else {
		files[f].open = false
	}
	check(t, "S\" flash:oftest1.txt\" FILE-STATUS NIP 0= .", "0 ")
	// Boot interprets a file, unless a key comes.
	check(t, "S\" flash:oftest1.txt\" W/O CREATE-FILE . VALUE fi S\" : tboot 42 ;\" fi WRITE-LINE . fi CLOSE-FILE .", "0 0 0 ")
	ResetOutput()
	Boot("flash:oftest1.txt")
	check(t, "tboot .", "42 ")
	Key, Avail, nkeys, keys = testKey, keyLeft, 0, " 1 tboot ."
	ResetOutput()
	Boot("flash:oftest1.txt")
	Key, Avail = nil, nil
	if !same(Output(), "flash:oftest1.txt: a key within half a second skips it\nskipped\n") || nkeys != len(keys) {
		println("Boot was not skipped")
		t.Fail()
	}
	// The card, on the same pins, between the flash's commands.
	if sdOpen() {
		check(t, "S\" flash:oftest2.txt\" R/O OPEN-FILE . VALUE fj S\" sd:oftest3.txt\" W/O CREATE-FILE . VALUE fk PAD 10 fj READ-FILE . PAD SWAP fk WRITE-FILE . fj CLOSE-FILE . fk CLOSE-FILE .", "0 0 0 0 0 0 ")
		check(t, "S\" sd:oftest3.txt\" R/O OPEN-FILE . VALUE fl PAD 10 fl READ-FILE . PAD SWAP TYPE fl CLOSE-FILE . S\" sd:oftest3.txt\" DELETE-FILE .", "0 0 de0 0 ")
	}
	check(t, "S\" flash:oftest1.txt\" DELETE-FILE . S\" flash:oftest2.txt\" DELETE-FILE . S\" flash:OctoForth Test.text\" DELETE-FILE . S\" flash:oftest2.txt\" DELETE-FILE 0= .", "0 0 0 0 ")
	for f := range files {
		if files[f].open {
			printf("file %d left open\n", f)
			t.Fail()
		}
	}
}

func keyLeft() bool { return nkeys < len(keys) }

func TestTools(t *testing.T) {
	check(t, "VARIABLE tq 42 tq ! tq ?", "42 ")
	checkHas(t, "CREATE td 3 C, 65 C, 0 C, td 3 DUMP", "  03 41 00 ")
	checkHas(t, "td 3 DUMP", "  .A.")
	check(t, "GET-MS 20 MS GET-MS SWAP - DUP 19 > SWAP 30 < AND .", "-1 ")
	check(t, ": tms 20 MS ; GET-MS tms GET-MS SWAP - DUP 19 > SWAP 30 < AND .", "-1 ")
	check(t, "KEY? .", "0 ")
	check(t, "TRUE [IF] 1 [ELSE] 2 [THEN] . FALSE [IF] 1 [ELSE] 2 [THEN] .", "1 2 ")
	check(t, "FALSE [IF] 1 TRUE [IF] 2 [ELSE] 3 [THEN] [ELSE] 4 [THEN] .", "4 ")
	check(t, "TRUE [IF] 1 FALSE [if] 2 [else] 3 [then] [ELSE] 4 [THEN] . .", "3 1 ")
	check(t, ": tif [ 0 ] [IF] 1 [ELSE] 2 [THEN] ; tif .", "2 ")
	// Lines of the console are skipped until the [THEN].
	check(t, "FALSE [IF] 1\n2 .\n[ELSE] 3 [THEN] .", "3 ")
	check(t, "[ELSE] 5 .\n6 . [THEN] 7 .", "7 ")
	check(t, "[DEFINED] DUP . [UNDEFINED] DUP . [DEFINED] tnosuch . [UNDEFINED] tnosuch .", "-1 0 0 -1 ")
	check(t, ": tah AHEAD 1 THEN 2 ; tah .", "2 ")
	// ?REPEAT as ANS has it, CS-PICK leaving the loop's entry twice.
	check(t, ": t?rep 0 CS-PICK POSTPONE UNTIL ; IMMEDIATE : tpk 0 BEGIN 1+ DUP 2 > t?rep DUP 5 = UNTIL ; tpk .", "5 ")
	check(t, ": t?done POSTPONE IF 1 CS-ROLL ; IMMEDIATE : trl 3 BEGIN DUP t?done DUP . 1- REPEAT DROP ; trl", "3 2 1 ")
	check(t, ": tntr N>R -1 NR> ; 1 2 3 3 tntr . . . . . 7 0 tntr . . .", "3 3 2 1 -1 0 -1 7 ")
	check(t, ": tsyn1 1234 ; SYNONYM tsyn2 tsyn1 tsyn2 . SYNONYM tdup DUP 5 tdup . .", "1234 5 5 ")
	check(t, "BYE", "")
	if !bye {
		println("BYE did not end Quit")
		t.Fail()
	}
	bye = false
}
