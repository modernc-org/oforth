import "unsafe"

// The two spaces, which the program gives Init, so that it says how much
// of the hub RAM they have. Code is P2 instructions, written by the
// compiler and run where they are; data is the space HERE, ALLOT and ","
// address, which ANS Forth calls the data space. They are apart so that
// data laid down after a CREATE never lands in the middle of code. Both
// are hub RAM, and a Forth address is a hub address.
const (
	// The cells at the bottom of the data space that the system keeps.
	cellBase  = 0  // BASE
	cellState = 1  // STATE
	cellToIn  = 2  // >IN
	cellDP    = 3  // DP: HERE, the address of the next free byte
	dataFirst = 16 // the first byte HERE starts at
)

var (
	code []uint32
	cp   int // the next free long of the code space

	data []uint32

	// Where the data space begins, how many bytes it has, and its DP cell,
	// which Init sets, so that allot and comma, which compiled code calls
	// by the thousand, take neither a call nor the slice to know them: no
	// function is inlined in a build of OctoForth.
	dataAt  uint32
	dataLen int32
	dpCell  *uint32
)

func codeAddr(i int) uint32 {
	return uint32(uintptr(unsafe.Pointer(&code[0]))) + uint32(i)*4
}

// setData makes data the data space.
func setData(d []uint32) {
	data = d
	dataAt = uint32(uintptr(unsafe.Pointer(&data[0])))
	dataLen = int32(len(data)) * 4
	dpCell = &data[cellDP]
}

func dataBase() uint32 { return dataAt }

func here() uint32 { return *dpCell }

// dpOff answers HERE as an offset into the data space, and setDpOff sets
// it so; the cell DP holds it as an address, as a program sees it.
func dpOff() uint32 { return *dpCell - dataAt }

func setDpOff(o uint32) { *dpCell = dataAt + o }

func peek(a uint32) uint32 { return *(*uint32)(unsafe.Pointer(uintptr(a))) }

func poke(a, v uint32) { *(*uint32)(unsafe.Pointer(uintptr(a))) = v }

func peekb(a uint32) byte { return *(*byte)(unsafe.Pointer(uintptr(a))) }

func pokeb(a uint32, v byte) { *(*byte)(unsafe.Pointer(uintptr(a))) = v }

// allot moves HERE on by n bytes, which may be negative, and answers false,
// having aborted, when that leaves the data space.
func allot(n int32) bool {
	d := int32(*dpCell-dataAt) + n
	if d < dataFirst || d > dataLen {
		abort("data space")
		return false
	}
	*dpCell = dataAt + uint32(d)
	return true
}

func align() {
	for data[cellDP]&3 != 0 {
		data[cellDP]++
	}
}

func comma(v uint32) {
	a := *dpCell
	if allot(4) {
		*(*uint32)(unsafe.Pointer(uintptr(a))) = v
	}
}

func ccomma(v byte) {
	a := *dpCell
	if allot(1) {
		*(*byte)(unsafe.Pointer(uintptr(a))) = v
	}
}

func base() uint32 { return data[cellBase] }

func compiling() bool { return data[cellState] != 0 }

func setCompiling(on bool) {
	data[cellState] = 0
	if on {
		data[cellState] = 0xffffffff
	}
}
