import (
	"unsafe"
)

// Files, which INCLUDE and the FILE words read and write: a table of the
// open ones, each through a buffer of its own, which holds what was read
// or what is written and not yet sent. A name is of the host's directory,
// over 9P (nine.ogo), or, after sd: or SD:, of the SD card in the slot
// (fat.ogo, sd.ogo), or, after flash: or FLASH:, of the board's flash
// (flash.ogo), all behind the same functions, fileOpen, fileByte,
// fileWrite, fileSeek and the rest. A file's fileid is its place in the
// table plus one, so that none is 0, the console's SOURCE-ID, or -1,
// EVALUATE's.

const (
	maxFiles = 8
	fileBufN = 512
	maxName  = 64

	famRO     = 0          // R/O, W/O and R/W are 9P's modes
	famWO     = 1          //
	famRW     = 2          //
	famBin    = 4          // what BIN adds, which changes nothing
	iorIO     = 0xffffffdb // ANS's codes: -37, a file's I/O failed
	iorNoFile = 0xffffffda // and -38, no such file

	dmDir = 0x80000000 // a 9P mode's bit of a directory
)

type file struct {
	open   bool
	dirty  bool   // buf[:n] was written and is not on the host yet
	mode   uint32 // famRO, famWO or famRW
	off    uint32 // where in the file buf starts
	pos, n int    // buf[:n] is the file from off on, pos where in it
	buf    [fileBufN]byte
	name   [maxName]byte // for an error's message
	nname  int

	on     uint8  // onHost, onCard or onFlash; the rest of these the card's
	synced bool   // its entry says its first cluster and size
	gen    uint32 // volGen when it was opened
	first  uint32 // its first cluster, 0 if it has none
	size   uint32
	clus   uint32 // its cidx-th cluster, 0 when none is known
	cidx   uint32
	ent    dirPos // its entry, and some of them the flash's (flash.ogo)
}

// Where a file is.
const (
	onHost = iota
	onCard
	onFlash
)

var files [maxFiles]file

func fidOf(f int) uint32 { return uint32(2 + f) }

// fileOf answers the file of a fileid, if it is an open one.
func fileOf(id uint32) (int, bool) {
	f := int(id) - 1
	if f < 0 || f >= maxFiles || !files[f].open {
		return 0, false
	}
	return f, true
}

// fileOpen opens the file name in mode, creating it or emptying it first
// when create is set, and answers it, or -1, what went wrong being in
// nineErr.
func fileOpen(name []byte, mode uint32, create bool) int {
	f := 0
	for f < maxFiles && files[f].open {
		f++
	}
	if f == maxFiles {
		setNineErr("too many open files")
		return -1
	}
	fl := &files[f]
	s, on := nameOn(name)
	ok := false
	switch {
	case on == onCard:
		ok = cardOpen(f, s, mode, create)
	case on == onFlash:
		ok = flashOpen(f, s, mode, create)
	case create:
		ok = nineCreate(fidOf(f), name, mode)
	default:
		ok = nineWalk(0, fidOf(f), name) && nineOpen(fidOf(f), mode)
	}
	if !ok {
		return -1
	}
	fl.open = true
	fl.on = uint8(on)
	fl.dirty = false
	fl.mode = mode
	fl.off = 0
	fl.pos = 0
	fl.n = 0
	fl.nname = copy(fl.name[:], name)
	return f
}

// nameOn answers where the file name is, and its name there: sd:NAME or
// SD:NAME is the card's NAME, flash:NAME or FLASH:NAME the flash's, any
// other the host's.
func nameOn(name []byte) ([]byte, int) {
	switch {
	case hasPrefix(name, "SD:"):
		return name[3:], onCard
	case hasPrefix(name, "FLASH:"):
		return name[6:], onFlash
	}
	return name, onHost
}

// hasPrefix answers whether name begins with s, which is in upper case,
// regardless of case.
func hasPrefix(name []byte, s string) bool {
	if len(name) < len(s) {
		return false
	}
	for i := 0; i < len(s); i++ {
		if upper(name[i]) != s[i] {
			return false
		}
	}
	return true
}

// backRead reads into p what f has from off on, as the host or the card
// gives it, and answers how much, 0 at the file's end, or -1.
func backRead(f int, off uint32, p []byte) int {
	switch files[f].on {
	case onCard:
		return cardRead(f, off, p)
	case onFlash:
		return flashRead(f, off, p)
	}
	return nineRead(fidOf(f), off, p)
}

// backWrite writes p, or what of it goes in one go, to f at off, and
// answers how much, or -1 or 0.
func backWrite(f int, off uint32, p []byte) int {
	switch files[f].on {
	case onCard:
		return cardWrite(f, off, p)
	case onFlash:
		return flashWrite(f, off, p)
	}
	return nineWrite(fidOf(f), off, p)
}

// fileClose closes f, and answers whether what was written to it got to
// the host, the card or the flash.
func fileClose(f int) bool {
	fl := &files[f]
	if !fl.open {
		return true
	}
	ok := fileSync(f)
	fl.open = false
	if fl.on == onHost {
		nineClunk(fidOf(f))
	}
	return ok
}

// fileSync is fileFlush, and on the card or the flash makes the volume or
// the file's header say what was written.
func fileSync(f int) bool {
	ok := fileFlush(f)
	switch files[f].on {
	case onCard:
		ok = cardSync(f) && ok
	case onFlash:
		ok = flashSync(f) && ok
	}
	return ok
}

// fileFlush sends what was written to f to the host, the card or the flash. What could
// not be sent is lost.
func fileFlush(f int) bool {
	fl := &files[f]
	if !fl.dirty {
		return true
	}
	fl.dirty = false
	ok := true
	for at := 0; at < fl.n; {
		k := backWrite(f, fl.off+uint32(at), fl.buf[at:fl.n])
		if k <= 0 {
			ok = false
			break
		}
		at += k
	}
	fl.off += uint32(fl.n)
	fl.pos = 0
	fl.n = 0
	return ok
}

// fileByte answers the next byte of f, -1 at its end and -2 on an error.
// Right after a byte, files[f].pos-- gives it back.
func fileByte(f int) int {
	fl := &files[f]
	if fl.pos == fl.n {
		if !fileFlush(f) {
			return -2
		}
		fl.off += uint32(fl.n)
		fl.pos = 0
		fl.n = 0
		k := backRead(f, fl.off, fl.buf[:])
		if k < 0 {
			return -2
		}
		if k == 0 {
			return -1
		}
		fl.n = k
	}
	c := fl.buf[fl.pos]
	fl.pos++
	return int(c)
}

// fileRead reads into p what f has next, as much as p holds, and answers
// how much, less only at the end of the file, or -1 on an error.
func fileRead(f int, p []byte) int {
	fl := &files[f]
	n := 0
	for n < len(p) {
		if fl.pos == fl.n {
			c := fileByte(f)
			if c == -1 {
				break
			}
			if c < 0 {
				return -1
			}
			p[n] = byte(c)
			n++
			continue
		}
		k := copy(p[n:], fl.buf[fl.pos:fl.n])
		fl.pos += k
		n += k
	}
	return n
}

// fileWrite writes p to f where it is, through its buffer.
func fileWrite(f int, p []byte) bool {
	fl := &files[f]
	if fl.mode == famRO {
		return false
	}
	if !fl.dirty {
		// What was read after where the file is is let go.
		fl.off += uint32(fl.pos)
		fl.pos = 0
		fl.n = 0
	}
	for len(p) > 0 {
		k := copy(fl.buf[fl.n:], p)
		p = p[k:]
		fl.n += k
		fl.pos = fl.n
		fl.dirty = true
		if fl.n == fileBufN && !fileFlush(f) {
			return false
		}
	}
	return true
}

// filePos answers where in f the next byte is read or written.
func filePos(f int) uint32 { return files[f].off + uint32(files[f].pos) }

// fileSeek makes to where in f the next byte is read or written.
func fileSeek(f int, to uint32) bool {
	fl := &files[f]
	if !fileFlush(f) {
		return false
	}
	if to >= fl.off && to-fl.off <= uint32(fl.n) {
		fl.pos = int(to - fl.off)
		return true
	}
	fl.off = to
	fl.pos = 0
	fl.n = 0
	return true
}

// fileSize answers how long f is.
func fileSize(f int) (uint32, bool) {
	if files[f].on != onHost {
		ok := fileFlush(f)
		return files[f].size, ok
	}
	if !fileFlush(f) || !nineStat(fidOf(f)) {
		return 0, false
	}
	return get4(statLength), get4(statLength+4) == 0
}

// fileResize makes f size bytes long, where it is in it staying.
func fileResize(f int, size uint32) bool {
	fl := &files[f]
	if !fileFlush(f) {
		return false
	}
	fl.off += uint32(fl.pos)
	fl.pos = 0
	fl.n = 0
	switch fl.on {
	case onCard:
		return cardResize(f, size)
	case onFlash:
		setNineErr("a flash: file is not resized")
		return false
	}
	return nineWstat(fidOf(f), size, nil)
}

// lastSlash answers where the last slash of name is, -1 if it has none.
func lastSlash(name []byte) int {
	k := len(name) - 1
	for k >= 0 && name[k] != '/' {
		k--
	}
	return k
}

// plainName answers whether name names a file below the directory served,
// or the card's root, so that what is removed or renamed by it is never
// that directory.
func plainName(name []byte) bool {
	parts := 0
	for i := 0; i < len(name); {
		j := i
		for j < len(name) && name[j] != '/' {
			j++
		}
		p := name[i:j]
		if len(p) == 1 && p[0] == '.' || len(p) == 2 && p[0] == '.' && p[1] == '.' {
			return false
		}
		if len(p) > 0 {
			parts++
		}
		i = j + 1
	}
	if parts == 0 {
		setNineErr("a file name is missing")
		return false
	}
	return true
}

// fileStatus answers the 9P mode of the file name, if there is one.
func fileStatus(name []byte) (uint32, bool) {
	switch s, on := nameOn(name); on {
	case onCard:
		return cardStatus(s)
	case onFlash:
		return flashStatus(s)
	}
	if !nineWalk(0, nineTemp, name) {
		return 0, false
	}
	ok := nineStat(nineTemp)
	m := get4(statMode)
	nineClunk(nineTemp)
	return m, ok
}

// fileDelete removes the file name, which is to be no directory.
func fileDelete(name []byte) bool {
	s, on := nameOn(name)
	if !plainName(s) {
		return false
	}
	switch on {
	case onCard:
		return cardDelete(s)
	case onFlash:
		return flashDelete(s)
	}
	m, ok := fileStatus(name)
	if !ok {
		return false
	}
	if m&dmDir != 0 {
		setNineErr("a directory")
		return false
	}
	return nineWalk(0, nineTemp, name) && nineRemove(nineTemp)
}

// fileRename renames the file from to; 9P renames a file within its
// directory only, and so does the card, as alike. A file of the flash is
// not renamed.
func fileRename(from, to []byte) bool {
	from, fc := nameOn(from)
	to, tc := nameOn(to)
	switch {
	case fc != tc:
		setNineErr("a file stays where it is")
		return false
	case fc == onFlash:
		setNineErr("a flash: file is not renamed")
		return false
	}
	if !plainName(from) || !plainName(to) {
		return false
	}
	i, j := lastSlash(from), lastSlash(to)
	if !bytesEq(from[:i+1], to[:j+1]) {
		setNineErr("a file stays in its directory")
		return false
	}
	if fc == onCard {
		return cardRename(from, to)
	}
	if !nineWalk(0, nineTemp, from) {
		return false
	}
	ok := nineWstat(nineTemp, 0xffffffff, to[j+1:])
	nineClunk(nineTemp)
	return ok
}

func bytesEq(a, b []byte) bool {
	if len(a) != len(b) {
		return false
	}
	for i := range a {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

// How a line fileLine read ended.
const (
	lineEnd  = iota // at its end, which was taken
	lineLong        // where p was full, the rest still to read
	lineEOF         // there was none: the file is at its end
	lineErr         // the file could not be read
)

// fileLine reads the next line of f into p and answers its length and how
// it ended. A line ends at LF, CR or CR LF, which are not part of it, and
// the last one may end at the end of the file.
func fileLine(f int, p []byte) (int, int) {
	fl := &files[f]
	n := 0
	for {
		c := fileByte(f)
		switch {
		case c == -1:
			if n == 0 {
				return 0, lineEOF
			}
			return n, lineEnd
		case c < 0:
			return n, lineErr
		case c == '\n':
			return n, lineEnd
		case c == '\r':
			d := fileByte(f)
			if d >= 0 && d != '\n' {
				fl.pos--
			}
			return n, lineEnd
		}
		if n == len(p) {
			fl.pos--
			return n, lineLong
		}
		p[n] = byte(c)
		n++
	}
}

// memory answers the n bytes at a.
func memory(a, n uint32) []byte {
	return unsafe.Slice((*byte)(unsafe.Pointer(uintptr(a))), int(n))
}

// The files being included, the innermost last, each with the line it is
// at, where in the file that line starts, for SAVE-INPUT, and the line in
// a buffer of its own: a line must outlast the inclusion of another file
// from it.
const maxIncl = 8

var (
	incl [maxIncl]struct {
		f, line int32
		start   uint32
	}
	inclLine [maxIncl][256]byte
	nincl    int
)

// The names of the files INCLUDED, which REQUIRED includes no more: each
// a byte of its length and the name. A name that does not fit any more is
// not kept, and is included again.
var (
	inclNames  [1024]byte
	ninclNames int
)

func wasIncluded(name []byte) bool {
	for i := 0; i < ninclNames; {
		n := int(inclNames[i])
		if bytesEq(inclNames[i+1:i+1+n], name) {
			return true
		}
		i += 1 + n
	}
	return false
}

// included opens the file name and interprets it, and REQUIRED so only
// if it was not included yet.
func included(name []byte, required bool) {
	if len(name) == 0 {
		abort("a file name is missing")
		return
	}
	if required && wasIncluded(name) {
		return
	}
	f := fileOpen(name, famRO, false)
	if f < 0 {
		abortFile(name)
		return
	}
	if !wasIncluded(name) && len(name) < 256 && ninclNames+1+len(name) <= len(inclNames) {
		inclNames[ninclNames] = byte(len(name))
		copy(inclNames[ninclNames+1:], name)
		ninclNames += 1 + len(name)
	}
	includeFile(f)
}

// includeFile interprets f from its next line to its end and closes it,
// the input source being restored after. An error in it is reported with
// the file's name and the line's number, the innermost file's.
func includeFile(f int) {
	if nincl == maxIncl {
		fileClose(f)
		abort("files included too deep")
		return
	}
	k := nincl
	nincl++
	incl[k].f = int32(f)
	incl[k].line = 0
	s, sa, id, in := src, srcAddr, sourceID, toIn()
	for !aborted && refillFile(k) {
		interpret()
	}
	if aborted && nwhere == 0 {
		where(k)
	}
	nincl--
	fileClose(f)
	src, srcAddr, sourceID = s, sa, id
	setToIn(in)
}

// refillFile makes the next line of the k-th file included the input
// source, and answers false at the end of the file or on an error.
func refillFile(k int) bool {
	f := int(incl[k].f)
	incl[k].start = filePos(f)
	n, how := fileLine(f, inclLine[k][:])
	switch how {
	case lineEOF:
		return false
	case lineErr:
		abortFile(files[f].name[:files[f].nname])
		return false
	case lineLong:
		incl[k].line++
		abort("line too long")
		return false
	}
	incl[k].line++
	src = inclLine[k][:n]
	srcAddr = uint32(uintptr(unsafe.Pointer(&inclLine[k][0])))
	sourceID = uint32(f + 1)
	setToIn(0)
	return true
}

// inFile answers the k of the file included that is the input source, or
// -1 when it is no file.
func inFile() int {
	if nincl > 0 && sourceID == uint32(incl[nincl-1].f+1) {
		return nincl - 1
	}
	return -1
}

// saveFile answers what SAVE-INPUT keeps of the file included that is
// the input source, the k-th: where its line starts, and the line's
// number.
func saveFile(k int) (uint32, uint32) {
	return incl[k].start, uint32(incl[k].line)
}

// restoreFile makes the line of the k-th file included that starts at
// start, and is its n-th, the input source again. (n is not named line:
// OctoGo takes a name of a function standing alone for that function used
// as a value, and line, a func() bool, would then seem callable through
// Avail, making the file layer look recursive.)
func restoreFile(k int, start, n uint32) bool {
	f := int(incl[k].f)
	if !fileSeek(f, start) {
		return false
	}
	incl[k].line = int32(n) - 1
	return refillFile(k)
}

// comment skips a ( comment, which in a file goes on over its lines.
func comment() {
	for {
		s := parse(')')
		if parsed+len(s) < len(src) {
			return
		}
		k := inFile()
		if k < 0 || !refillFile(k) {
			return
		}
	}
}

// Where an error was found, "name:line: ", for line to write before it.
var (
	errWhere [maxName + 16]byte
	nwhere   int
)

func where(k int) {
	f := int(incl[k].f)
	nwhere = copy(errWhere[:], files[f].name[:files[f].nname])
	errWhere[nwhere] = ':'
	nwhere++
	var d [10]byte
	i := len(d)
	for v := uint32(incl[k].line); ; v /= 10 {
		i--
		d[i] = byte('0' + v%10)
		if v < 10 {
			break
		}
	}
	nwhere += copy(errWhere[nwhere:], d[i:])
	errWhere[nwhere] = ':'
	errWhere[nwhere+1] = ' '
	nwhere += 2
}

// abortFile aborts for the file name, with what went wrong.
func abortFile(name []byte) {
	if aborted {
		return
	}
	abortName(name, ": ")
	abortCode = throwNoFile
	nmore = copy(errMore[:], nineErr[:nnineErr])
}

func flag(b bool) uint32 {
	if b {
		return 0xffffffff
	}
	return 0
}

// ior answers the ior of what went well or not.
func ior(ok bool) uint32 {
	if ok {
		return 0
	}
	return iorIO
}

var lf = [...]byte{'\n'} // what WRITE-LINE ends a line with

// octoFile executes the file words.
func octoFile(id int) {
	switch id {
	case oIncluded, oRequired:
		n := pop()
		included(memory(pop(), n), id == oRequired)
	case oInclude, oRequire:
		s := nameOrAbort()
		if !aborted {
			included(s, id == oRequire)
		}
	case oIncludeFile:
		f, ok := fileOf(pop())
		if !ok {
			abort("not an open file")
			return
		}
		includeFile(f)
	case oOpenFile, oCreateFile:
		fam := pop() &^ famBin
		n := pop()
		s := memory(pop(), n)
		f := -1
		if fam <= famRW {
			f = fileOpen(s, fam, id == oCreateFile)
		}
		if f < 0 {
			push(0)
			if id == oOpenFile {
				push(iorNoFile)
			} else {
				push(iorIO)
			}
			return
		}
		push(uint32(f + 1))
		push(0)
	case oCloseFile:
		f, ok := fileOf(pop())
		push(ior(ok && fileClose(f)))
	case oReadFile:
		f, ok := fileOf(pop())
		n := pop()
		p := memory(pop(), n)
		k := -1
		if ok {
			k = fileRead(f, p)
		}
		if k < 0 {
			push(0)
			push(iorIO)
			return
		}
		push(uint32(k))
		push(0)
	case oReadLine:
		f, ok := fileOf(pop())
		n := pop()
		p := memory(pop(), n)
		how := lineErr
		k := 0
		if ok {
			k, how = fileLine(f, p)
		}
		switch how {
		case lineEOF:
			push(0)
			push(0)
			push(0)
		case lineErr:
			push(0)
			push(0)
			push(iorIO)
		default:
			push(uint32(k))
			push(flag(true))
			push(0)
		}
	case oWriteFile, oWriteLine:
		f, ok := fileOf(pop())
		n := pop()
		p := memory(pop(), n)
		ok = ok && fileWrite(f, p)
		if ok && id == oWriteLine {
			ok = fileWrite(f, lf[:])
		}
		push(ior(ok))
	case oFlushFile:
		f, ok := fileOf(pop())
		push(ior(ok && fileSync(f)))
	case oFilePosition, oFileSize:
		f, ok := fileOf(pop())
		v := uint32(0)
		switch {
		case !ok:
		case id == oFilePosition:
			v = filePos(f)
		default:
			v, ok = fileSize(f)
		}
		push(v)
		push(0)
		push(ior(ok))
	case oRepositionFile, oResizeFile:
		f, ok := fileOf(pop())
		hi := pop()
		lo := pop()
		switch {
		case !ok || hi != 0:
			ok = false
		case id == oRepositionFile:
			ok = fileSeek(f, lo)
		default:
			ok = fileResize(f, lo)
		}
		push(ior(ok))
	case oDeleteFile:
		n := pop()
		push(ior(fileDelete(memory(pop(), n))))
	case oRenameFile:
		n := pop()
		to := memory(pop(), n)
		n = pop()
		push(ior(fileRename(memory(pop(), n), to)))
	case oFileStatus:
		n := pop()
		m, ok := fileStatus(memory(pop(), n))
		push(m)
		if ok {
			push(0)
		} else {
			push(iorNoFile)
		}
	case oBin:
		push(pop() | famBin)
	default:
		octoCog(id)
	}
}
