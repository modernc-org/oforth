// The DOUBLE word set's OctoGo words; its arithmetic is PASM, the templates
// D+ to 2ROT, and a number ending in a point is a double (interp.ogo). A
// double is a pair of cells with the high one on top.

func octoDouble(id int) {
	switch id {
	case o2Constant, o2Value:
		x2 := pop()
		x1 := pop()
		s := nameOrAbort()
		if aborted {
			return
		}
		align()
		cell := here()
		k := uint8(k2Const)
		if id == o2Constant {
			comma(x1)
			comma(x2)
		} else {
			k = k2Value
			comma(x2) // as 2! stores them
			comma(x1)
		}
		w := define(s, k, 0)
		if w >= 0 {
			words[w].val = cell
			standalone2(w, k == k2Value)
		}
	case o2Variable:
		s := nameOrAbort()
		if aborted {
			return
		}
		align()
		a := here()
		comma(0)
		comma(0)
		w := define(s, kConst, 0)
		if w >= 0 {
			words[w].val = a
			standaloneLit(w, a)
		}
	case o2Literal:
		x2 := pop()
		compileLit(pop())
		compileLit(x2)
	case oDDot:
		typeBytes(ddigits(popd()))
		emit(' ')
	case oDDotR:
		n := int32(pop())
		s := ddigits(popd())
		spaces(n - int32(len(s)))
		typeBytes(s)
	case oMStarSlash:
		n2 := int32(pop())
		n1 := int32(pop())
		pushd(uint64(mStarSlash(int64(popd()), n1, n2)))
	default:
		octoString(id)
	}
}

// to2 is TO of the 2VALUE w.
func to2(w int) {
	a := words[w].val
	if compiling() {
		compileLit(a)
		compileWord(w2Store)
		return
	}
	if depth() < 2 {
		abort("stack underflow")
		return
	}
	poke(a, pop())
	poke(a+4, pop())
}

// ddigits is digits for a signed double.
func ddigits(d uint64) []byte {
	b := uint64(base())
	if b < 2 || b > 36 {
		b = 10
	}
	neg := int64(d) < 0
	if neg {
		d = -d
	}
	i := len(numBuf)
	for {
		r := d % b
		d /= b
		i--
		if r < 10 {
			numBuf[i] = byte('0' + r)
		} else {
			numBuf[i] = byte('A' + r - 10)
		}
		if d == 0 {
			break
		}
	}
	if neg {
		i--
		numBuf[i] = '-'
	}
	return numBuf[i:]
}

// mStarSlash answers d*n1/n2 as M*/ does, the product of three cells and the
// quotient truncated toward zero, as / truncates.
func mStarSlash(d int64, n1, n2 int32) int64 {
	neg := false
	ud := uint64(d)
	if d < 0 {
		ud = -ud
		neg = true
	}
	u1 := uint64(int64(n1))
	if n1 < 0 {
		u1 = uint64(-int64(n1))
		neg = !neg
	}
	u2 := uint64(int64(n2))
	if n2 < 0 {
		u2 = uint64(-int64(n2))
		neg = !neg
	}
	if u2 == 0 {
		abort("division by zero")
		return 0
	}
	// The product: bits 0 to 31 in lo's low half, 32 to 95 in hi.
	lo := (ud & 0xffffffff) * u1
	hi := (ud>>32)*u1 + lo>>32
	r := hi >> 32
	r %= u2
	t := r<<32 | hi&0xffffffff
	q1 := t / u2
	t = t%u2<<32 | lo&0xffffffff
	q := q1<<32 | t/u2
	if neg {
		return -int64(q)
	}
	return int64(q)
}
