// Words the compiler compiles where it makes something of its own.
var wType, wFetch, wStore, wExecute, wDrop, wAbort, w2Fetch, w2Store int

func octoWord(s string, id int, flags uint8) int {
	w := defineStr(s, kOcto, flags)
	words[w].id = uint16(id)
	standaloneTrap(w)
	return w
}

func constWord(s string, v uint32) {
	w := defineStr(s, kConst, 0)
	words[w].val = v
	standaloneLit(w, v)
}

// octoNames are the OctoGo words' names in the order of their numbers, oDot's
// first, parted by white space; octoFlags has the flags of those with any.
// A table, not a call for each word, as the code of 150 calls is 6 KB.
const octoNames = `. U. .R U.R .S EMIT CR SPACE SPACES TYPE KEY WORDS : ; IMMEDIATE ( \ .(
HERE , C, ALLOT ALIGN ALIGNED CONSTANT VARIABLE CREATE ' ['] RECURSE IF
ELSE THEN BEGIN UNTIL AGAIN WHILE REPEAT DO ?DO LOOP +LOOP LEAVE EXIT [
] LITERAL ." S" CHAR [CHAR] */ */MOD FM/MOD SM/REM DECIMAL HEX MOVE
ABORT DOES> ~does >BODY POSTPONE COMPILE, <# # #S #> HOLD HOLDS SIGN
EVALUATE SOURCE SOURCE-ID WORD FIND >NUMBER PARSE PARSE-NAME ACCEPT QUIT
ABORT" ~abort" ENVIRONMENT? CASE OF ENDOF ENDCASE VALUE TO DEFER IS
ACTION-OF :NONAME ERASE ROLL UNUSED BUFFER: C" REFILL SEE MARKER ~marker
SAVE-INPUT RESTORE-INPUT DEFER@ DEFER! S\" RECURSIVE INCLUDED INCLUDE
INCLUDE-FILE OPEN-FILE CLOSE-FILE READ-FILE READ-LINE BIN CREATE-FILE
WRITE-FILE WRITE-LINE FLUSH-FILE FILE-POSITION FILE-SIZE REPOSITION-FILE
RESIZE-FILE DELETE-FILE RENAME-FILE FILE-STATUS REQUIRED REQUIRE RUN
CATCH THROW 2CONSTANT 2VARIABLE 2VALUE 2LITERAL D. D.R M*/ -TRAILING
BLANK CMOVE CMOVE> COMPARE SEARCH SLITERAL UNESCAPE SUBSTITUTE REPLACES`

const fIC = fImmediate | fCompile

var octoFlags = [...]struct{ id, flags uint8 }{
	{oSemicolon, fIC},
	{oParen, fImmediate},
	{oBackslash, fImmediate},
	{oDotParen, fImmediate},
	{oBracketTick, fIC},
	{oRecurse, fIC},
	{oIf, fIC},
	{oElse, fIC},
	{oThen, fIC},
	{oBegin, fIC},
	{oUntil, fIC},
	{oAgain, fIC},
	{oWhile, fIC},
	{oRepeat, fIC},
	{oDo, fIC},
	{oQDo, fIC},
	{oLoop, fIC},
	{oPlusLoop, fIC},
	{oLeave, fIC},
	{oExit, fIC},
	{oLeftBracket, fIC},
	{oLiteral, fIC},
	{oDotQuote, fIC},
	{oSQuote, fImmediate},
	{oBracketChar, fIC},
	{oDoes, fIC},
	{oDoesRT, fHidden},
	{oPostpone, fIC},
	{oAbortQuote, fIC},
	{oAbortQRT, fHidden},
	{oCase, fIC},
	{oOf, fIC},
	{oEndof, fIC},
	{oEndcase, fIC},
	{oTo, fImmediate},
	{oIs, fImmediate},
	{oActionOf, fImmediate},
	{oCQuote, fIC},
	{oMarkerRT, fHidden},
	{oSQuoteEsc, fImmediate},
	{oRecursive, fIC},
	{o2Literal, fIC},
	{oSLiteral, fIC},
}

func octoWords() {
	// The words whose compile semantics use others look them up first.
	wFetch = findStr("@")
	w2Fetch = findStr("2@")
	w2Store = findStr("2!")
	wStore = findStr("!")
	wExecute = findStr("EXECUTE")
	wDrop = findStr("DROP")
	id := oDot
	for i := 0; i < len(octoNames); {
		for i < len(octoNames) && isSpace(octoNames[i]) {
			i++
		}
		j := i
		for j < len(octoNames) && !isSpace(octoNames[j]) {
			j++
		}
		if j > i {
			f := uint8(0)
			for _, e := range octoFlags {
				if int(e.id) == id {
					f = e.flags
				}
			}
			octoWord(octoNames[i:j], id, f)
			id++
		}
		i = j
	}
	wType = findStr("TYPE")
	wAbort = findStr("ABORT")
	constWord("R/O", famRO)
	constWord("W/O", famWO)
	constWord("R/W", famRW)
	constWord("BASE", dataBase()+cellBase*4)
	constWord("STATE", dataBase()+cellState*4)
	constWord(">IN", dataBase()+cellToIn*4)
	constWord("DP", dataBase()+cellDP*4)
	constWord("PAD", uint32(uintptr(unsafe.Pointer(&pad[0]))))
}

func findStr(s string) int {
	var b [32]byte
	for i := 0; i < len(s); i++ {
		b[i] = s[i]
	}
	w := find(b[:len(s)])
	if w < 0 {
		panic("a word is missing")
	}
	return w
}

// Init makes the system in the code and data spaces given, which it keeps:
// the templates' words, OctoGo's, and the empty stacks. It is called once.
// The data space must have room for the system's cells, dataFirst bytes.
func Init(codeSpace, dataSpace []uint32) {
	if len(codeSpace) > 65535 {
		panic("the code space is over 65535 longs")
	}
	code = codeSpace
	data = dataSpace
	for i := range bucket {
		bucket[i] = -1
	}
	setDpOff(dataFirst)
	data[cellBase] = 10
	setCompiling(false)
	loadTemplates()
	octoWords()
	reset()
}

// The digits of a number, written from the end of numBuf.
var numBuf [72]byte // a double's 64 binary digits and a sign

func digits(v uint32, signed bool) []byte {
	b := base()
	if b < 2 || b > 36 {
		b = 10
	}
	neg := signed && int32(v) < 0
	if neg {
		v = -v
	}
	i := len(numBuf)
	for {
		d := v % b
		v /= b
		i--
		if d < 10 {
			numBuf[i] = byte('0' + d)
		} else {
			numBuf[i] = byte('A' + d - 10)
		}
		if v == 0 {
			break
		}
	}
	if neg {
		i--
		numBuf[i] = '-'
	}
	return numBuf[i:]
}

func spaces(n int32) {
	for ; n > 0; n-- {
		emit(' ')
	}
}

func dotR(v uint32, width int32, signed bool) {
	s := digits(v, signed)
	spaces(width - int32(len(s)))
	typeBytes(s)
}

func dotS() {
	n := depth()
	emit('<')
	typeBytes(digits(uint32(n), true))
	typeStr("> ")
	for i := n - 1; i >= 0; i-- {
		typeBytes(digits(nth(i), true))
		emit(' ')
	}
}

func listWords() {
	col := 0
	for w := nwords - 1; w >= 0; w-- {
		if words[w].flags&fHidden != 0 {
			continue
		}
		n := int(words[w].nlen)
		if col > 0 && col+n+1 > 72 {
			emit('\n')
			col = 0
		}
		if col > 0 {
			emit(' ')
			col++
		}
		typeBytes(wordName(w))
		col += n
	}
}

// nameOrAbort parses a name, which must be there.
func nameOrAbort() []byte {
	s := parseName()
	if len(s) == 0 {
		abort("a name is missing")
	}
	return s
}

func findOrAbort() int {
	s := nameOrAbort()
	if aborted {
		return -1
	}
	w := find(s)
	if w < 0 {
		abortName(s, " ?")
	}
	return w
}

// stringHere lays s down in the data space and answers where.
func stringHere(s []byte) uint32 {
	a := here()
	for _, c := range s {
		ccomma(c)
	}
	return a
}

// Where an interpreted S" or S\" leaves its string, the two buffers taking
// turns, so that the string before is still there.
var (
	sbuf  [2][256]byte
	nsbuf int
)

// sbufNext answers the buffer of the next interpreted string.
func sbufNext() []byte {
	nsbuf ^= 1
	return sbuf[nsbuf][:]
}

func d2(hi, lo uint32) int64 { return int64(uint64(hi)<<32 | uint64(lo)) }

// needs answers how many cells the OctoGo word id takes from the stack.
func needs(id int) int {
	switch id {
	case oDot, oUDot, oEmit, oSpaces, oComma, oCComma, oAllot, oAligned,
		oConstant, oLiteral:
		return 1
	case oDotR, oUDotR, oType:
		return 2
	case oStarSlash, oStarSlashMod, oFmMod, oSmRem, oMove, oAbortQRT:
		return 3
	case oDoesRT, oToBody, oCompileComma, oHold, oSign, oWord, oFind,
		oParse, oValue, oRoll, oBuffer, oQuit:
		if id == oQuit {
			return 0
		}
		return 1
	case oHash, oHashS, oHashGreater, oHolds, oEvaluate, oAccept,
		oEnvironment, oErase:
		return 2
	case oToNumber:
		return 4
	case oMarkerRT, oDeferFetch:
		return 1
	case oDeferStore:
		return 2
	case oRestoreInput:
		return 5
	case oIncluded, oRequired, oDeleteFile, oFileStatus:
		return 2
	case oIncludeFile, oCloseFile, oBin, oFlushFile, oFilePosition, oFileSize:
		return 1
	case oOpenFile, oReadFile, oReadLine, oCreateFile, oWriteFile, oWriteLine,
		oRepositionFile, oResizeFile:
		return 3
	case oRenameFile:
		return 4
	case oRun:
		return 2
	case oCatch, oThrow:
		return 1
	case o2Constant, o2Value, o2Literal, oDDot, oDashTrailing, oBlank, oSLiteral:
		return 2
	case oDDotR, oCMove, oCMoveUp, oUnescape:
		return 3
	case oMStarSlash, oCompare, oSearch, oSubstitute, oReplaces:
		return 4
	}
	if i := id - oExported; i >= 0 && i < nexported {
		return int(exportedIn[i])
	}
	return 0
}

// octo executes the OctoGo word numbered id.
func octo(id int) {
	if depth() < needs(id) {
		abort("stack underflow")
		return
	}
	switch id {
	case oDot:
		typeBytes(digits(pop(), true))
		emit(' ')
	case oUDot:
		typeBytes(digits(pop(), false))
		emit(' ')
	case oDotR:
		n := int32(pop())
		dotR(pop(), n, true)
	case oUDotR:
		n := int32(pop())
		dotR(pop(), n, false)
	case oDotS:
		dotS()
	case oEmit:
		emit(byte(pop()))
	case oCr:
		emit('\n')
	case oSpace:
		emit(' ')
	case oSpaces:
		spaces(int32(pop()))
	case oType:
		n := pop()
		a := pop()
		for i := uint32(0); i < n; i++ {
			emit(peekb(a + i))
		}
	case oKey:
		if Key == nil {
			push(0xffffffff)
			return
		}
		push(uint32(inKey()))
	case oWords:
		listWords()
	case oColon:
		s := nameOrAbort()
		if !aborted {
			beginColon(s, false)
		}
	case oSemicolon:
		endColon()
	case oImmediate:
		if nwords > 0 {
			words[nwords-1].flags |= fImmediate
		}
	case oParen:
		comment()
	case oBackslash:
		setToIn(len(src))
	case oDotParen:
		typeBytes(parse(')'))
	case oHere:
		push(here())
	case oComma:
		comma(pop())
	case oCComma:
		ccomma(byte(pop()))
	case oAllot:
		allot(int32(pop()))
	case oAlign:
		align()
	case oAligned:
		push((pop() + 3) &^ 3)
	case oConstant:
		s := nameOrAbort()
		v := pop()
		if aborted {
			return
		}
		w := define(s, kConst, 0)
		if w >= 0 {
			words[w].val = v
			standaloneLit(w, v)
		}
	case oVariable, oCreate:
		s := nameOrAbort()
		if aborted {
			return
		}
		align()
		a := here()
		if id == oVariable {
			comma(0)
		}
		w := define(s, kConst, 0)
		if w >= 0 {
			words[w].val = a
			standaloneLit(w, a)
		}
	case oTick:
		w := findOrAbort()
		if w >= 0 {
			push(words[w].xt)
		}
	case oBracketTick:
		w := findOrAbort()
		if w >= 0 {
			compileLit(words[w].xt)
		}
	case oRecurse:
		flushLit()
		emitAbs(tCall, words[current].xt)
	case oIf:
		compileIf()
	case oElse:
		compileElse()
	case oThen:
		compileThen()
	case oBegin:
		compileBegin()
	case oUntil:
		compileUntil()
	case oAgain:
		compileAgain()
	case oWhile:
		compileWhile()
	case oRepeat:
		compileRepeat()
	case oDo:
		compileDo(false)
	case oQDo:
		compileDo(true)
	case oLoop:
		compileLoop(false)
	case oPlusLoop:
		compileLoop(true)
	case oLeave:
		compileLeave()
	case oExit:
		flushLit()
		inlinable = false
		lastNoRep = cp
		emitT(tExit)
	case oLeftBracket:
		flushLit()
		setCompiling(false)
	case oRightBracket:
		setCompiling(true)
	case oLiteral:
		compileLit(pop())
	case oDotQuote:
		s := parse('"')
		a := stringHere(s)
		compileLit(a)
		compileLit(uint32(len(s)))
		compileWord(wType)
	case oSQuote:
		s := parse('"')
		if compiling() {
			a := stringHere(s)
			compileLit(a)
			compileLit(uint32(len(s)))
			return
		}
		b := sbufNext()
		n := copy(b, s)
		push(uint32(uintptr(unsafe.Pointer(&b[0]))))
		push(uint32(n))
	case oChar:
		s := nameOrAbort()
		if !aborted {
			push(uint32(s[0]))
		}
	case oBracketChar:
		s := nameOrAbort()
		if !aborted {
			compileLit(uint32(s[0]))
		}
	case oStarSlash, oStarSlashMod:
		n3 := int64(int32(pop()))
		n2 := int64(int32(pop()))
		n1 := int64(int32(pop()))
		if n3 == 0 {
			abort("division by zero")
			return
		}
		p := n1 * n2
		if id == oStarSlashMod {
			push(uint32(p % n3))
		}
		push(uint32(p / n3))
	case oFmMod, oSmRem:
		n := int64(int32(pop()))
		hi := pop()
		lo := pop()
		if n == 0 {
			abort("division by zero")
			return
		}
		d := d2(hi, lo)
		q := d / n
		r := d % n
		if id == oFmMod && r != 0 && (r < 0) != (n < 0) {
			q--
			r += n
		}
		push(uint32(r))
		push(uint32(q))
	case oDecimal:
		data[cellBase] = 10
	case oHex:
		data[cellBase] = 16
	case oMove:
		n := pop()
		d := pop()
		s := pop()
		if d < s {
			for i := uint32(0); i < n; i++ {
				pokeb(d+i, peekb(s+i))
			}
		} else {
			for i := n; i > 0; i-- {
				pokeb(d+i-1, peekb(s+i-1))
			}
		}
	case oAbort:
		abortQuiet(throwAbort)
	default:
		octo2(id)
	}
}

var (
	pad     [128]byte
	hold    [128]byte // the pictured number, built from its end
	hld     int
	wordBuf [258]byte // WORD's counted string
	endofs  [64]int32
	nendofs int
	anon    = [...]byte{'~', 'n', 'o', 'n', 'a', 'm', 'e'}
)

func holdc(c byte) {
	if hld == 0 {
		abort("pictured number too long")
		return
	}
	hld--
	hold[hld] = c
}

func popd() uint64 {
	hi := pop()
	lo := pop()
	return uint64(hi)<<32 | uint64(lo)
}

func pushd(d uint64) {
	push(uint32(d))
	push(uint32(d >> 32))
}

// digit answers the value of c as a digit, 99 if it is none.
func digit(c byte) uint32 {
	c = upper(c)
	switch {
	case c >= '0' && c <= '9':
		return uint32(c - '0')
	case c >= 'A' && c <= 'Z':
		return uint32(c-'A') + 10
	}
	return 99
}

func setNth(n int, v uint32) {
	if n == 0 {
		engSetTos(v)
		return
	}
	p2.WriteLUT(engGetDsp()-uint32(n), v)
}

// valueOf parses a name for TO, IS and ACTION-OF, which must be of kind k.
func valueOf(k uint8) int {
	w := findOrAbort()
	if w < 0 {
		return -1
	}
	if words[w].kind != k && !(k == kValue && words[w].kind == k2Value) {
		abortName(wordName(w), " is of another kind")
		return -1
	}
	return w
}

// octo2 executes the OctoGo words of M2.
func octo2(id int) {
	switch id {
	case oDoes:
		inlinable = false
		if nloops > 0 {
			// The literal below is a place in this code, which
			// taking out an open loop's reservations would move.
			cacheOff = true
		}
		// The defining word ends here, telling ~does where the code after
		// DOES> begins, which is right after this; the literal is made of
		// its full three longs so that its place is known before it is.
		flushLit()
		at := cp
		emitT(tDup)
		emitw(tplLong(tAugs, 0))
		emitw(tplLong(tLit, 0))
		emitImm(tTrap, oDoesRT)
		emitT(tExit)
		a := codeAddr(cp)
		code[at+1] |= a >> 9
		code[at+2] |= a & 511
		emitT(tEnter)
	case oDoesRT:
		d := pop()
		w := nwords - 1
		// The word may have DOES> code already: a second DOES> replaces
		// it, as when a DOES> part runs another.
		if w < 0 || words[w].kind != kConst && words[w].kind != kDoes || words[w].ret == noRet {
			abort("DOES> without CREATE")
			return
		}
		words[w].kind = kDoes
		words[w].does = d
		code[words[w].ret] = tplLong(tJmp, 0) | d&0xfffff
	case oToBody:
		w := wordOfXt(pop())
		if w < 0 || words[w].kind != kConst && words[w].kind != kDoes {
			abort(">BODY of no CREATE")
			return
		}
		push(words[w].val)
	case oPostpone:
		w := findOrAbort()
		if w < 0 {
			return
		}
		if words[w].flags&fImmediate != 0 {
			compileWord(w)
			return
		}
		compileLit(words[w].xt)
		compileWord(findStr("COMPILE,"))
	case oCompileComma:
		xt := pop()
		w := wordOfXt(xt)
		if w >= 0 {
			compileWord(w)
			return
		}
		flushLit()
		emitAbs(tCall, xt)
	case oLessHash:
		hld = len(hold)
	case oHash, oHashS:
		d := popd()
		b := uint64(base())
		for {
			r := d % b
			d /= b
			if r < 10 {
				holdc(byte('0' + r))
			} else {
				holdc(byte('A' + r - 10))
			}
			if id == oHash || d == 0 {
				break
			}
		}
		pushd(d)
	case oHashGreater:
		pop()
		pop()
		push(uint32(uintptr(unsafe.Pointer(&hold[0]))) + uint32(hld))
		push(uint32(len(hold) - hld))
	case oHold:
		holdc(byte(pop()))
	case oHolds:
		n := pop()
		a := pop()
		for i := n; i > 0; i-- {
			holdc(peekb(a + i - 1))
		}
	case oSign:
		if int32(pop()) < 0 {
			holdc('-')
		}
	case oEvaluate:
		n := pop()
		a := pop()
		evaluate(a, n)
	case oSource:
		push(srcAddr)
		push(uint32(len(src)))
	case oSourceID:
		push(sourceID)
	case oWord:
		c := byte(pop())
		skip(c)
		s := parse(c)
		n := len(s)
		if n > 255 {
			n = 255
		}
		wordBuf[0] = byte(n)
		copy(wordBuf[1:], s[:n])
		push(uint32(uintptr(unsafe.Pointer(&wordBuf[0]))))
	case oFind:
		a := pop()
		n := int(peekb(a))
		w := find(unsafe.Slice((*byte)(unsafe.Pointer(uintptr(a+1))), n))
		if w < 0 {
			push(a)
			push(0)
			return
		}
		push(words[w].xt)
		if words[w].flags&fImmediate != 0 {
			push(1)
		} else {
			push(0xffffffff)
		}
	case oToNumber:
		n := pop()
		a := pop()
		d := popd()
		b := base()
		for n > 0 {
			v := digit(peekb(a))
			if v >= b {
				break
			}
			d = d*uint64(b) + uint64(v)
			a++
			n--
		}
		pushd(d)
		push(a)
		push(n)
	case oParse:
		s := parse(byte(pop()))
		push(srcAddr + uint32(parsed))
		push(uint32(len(s)))
	case oParseName:
		s := parseName()
		push(srcAddr + uint32(parsed))
		push(uint32(len(s)))
	case oAccept:
		n := int(pop())
		a := pop()
		push(uint32(accept(a, n)))
	case oQuit:
		abortQuiet(throwQuit)
	case oAbortQuote:
		s := parse('"')
		a := stringHere(s)
		compileLit(a)
		compileLit(uint32(len(s)))
		flushLit()
		emitImm(tTrap, oAbortQRT)
	case oAbortQRT:
		n := pop()
		a := pop()
		if pop() != 0 && !aborted {
			abortQuiet(throwAbortQuote)
			abortMsg, nabortMsg = a, n
		}
	case oEnvironment:
		pop()
		pop()
		push(0)
	case oCase:
		flushLit()
		csPush(csCase, 0, nendofs)
	case oOf:
		flushLit()
		emitT(tOf)
		at := cp
		emitAbs(tJnz, 0)
		csPush(csOf, at, 0)
	case oEndof:
		flushLit()
		e := csPop(csOf)
		if aborted {
			return
		}
		if nendofs == len(endofs) {
			abort("too many ENDOFs")
			return
		}
		endofs[nendofs] = int32(cp)
		nendofs++
		emitAbs(tJmp, 0)
		resolve(int(e.at), codeAddr(cp))
	case oEndcase:
		flushLit()
		e := csPop(csCase)
		if aborted {
			return
		}
		emitT(int(words[wDrop].id))
		for i := int(e.leave); i < nendofs; i++ {
			resolve(int(endofs[i]), codeAddr(cp))
		}
		nendofs = int(e.leave)
	case oValue:
		v := pop()
		s := nameOrAbort()
		if aborted {
			return
		}
		align()
		cell := here()
		comma(v)
		w := define(s, kValue, 0)
		if w >= 0 {
			words[w].val = cell
			standaloneValue(w, cell)
		}
	case oDefer:
		s := nameOrAbort()
		if aborted {
			return
		}
		align()
		cell := here()
		comma(words[wAbort].xt)
		w := define(s, kDefer, 0)
		if w >= 0 {
			words[w].val = cell
			standaloneDefer(w, cell)
		}
	case oTo, oIs:
		k := uint8(kValue)
		if id == oIs {
			k = kDefer
		}
		w := valueOf(k)
		if w < 0 {
			return
		}
		if words[w].kind == k2Value {
			to2(w)
			return
		}
		if compiling() {
			compileLit(words[w].val)
			compileWord(wStore)
			return
		}
		if depth() < 1 {
			abort("stack underflow")
			return
		}
		poke(words[w].val, pop())
	case oActionOf:
		w := valueOf(kDefer)
		if w < 0 {
			return
		}
		if compiling() {
			compileLit(words[w].val)
			compileWord(wFetch)
			return
		}
		push(peek(words[w].val))
	case oNoname:
		beginColon(anon[:], true)
	case oErase:
		n := pop()
		a := pop()
		for i := uint32(0); i < n; i++ {
			pokeb(a+i, 0)
		}
	case oRoll:
		u := int(pop())
		if u < 0 || u >= depth() {
			abort("stack underflow")
			return
		}
		x := nth(u)
		for i := u; i > 0; i-- {
			setNth(i, nth(i-1))
		}
		setNth(0, x)
	case oUnused:
		push(uint32(len(data))*4 - dpOff())
	case oBuffer:
		n := pop()
		s := nameOrAbort()
		if aborted {
			return
		}
		align()
		a := here()
		if !allot(int32(n)) {
			return
		}
		w := define(s, kConst, 0)
		if w >= 0 {
			words[w].val = a
			standaloneLit(w, a)
		}
	case oCQuote:
		s := parse('"')
		a := here()
		ccomma(byte(len(s)))
		stringHere(s)
		compileLit(a)
	case oRefill:
		// A file's next line; the console's REFILL is not there yet.
		k := inFile()
		push(flag(k >= 0 && refillFile(k)))
	case oSee:
		w := findOrAbort()
		if w >= 0 {
			see(w)
		}
	case oMarker:
		s := nameOrAbort()
		if aborted {
			return
		}
		if nmarks == len(marks) {
			abort("too many MARKERs")
			return
		}
		m := nmarks
		marks[m].nwords = int32(nwords)
		marks[m].cp = int32(cp)
		marks[m].dp = dpOff()
		marks[m].nincl = int32(ninclNames)
		nmarks++
		w := define(s, kMarker, 0)
		if w < 0 {
			return
		}
		words[w].val = uint32(m)
		at := cp
		words[w].xt = codeAddr(cp)
		emitLit(uint32(m))
		emitImm(tTrap, oMarkerRT)
		emitT(tRet)
		words[w].size = uint16(cp - at)
	case oMarkerRT:
		backTo(int(pop()))
	case oSaveInput:
		// Of a file, where its line starts and the line's number; of
		// another source, where it is and how long.
		a, n := srcAddr, uint32(len(src))
		if k := inFile(); k >= 0 {
			a, n = saveFile(k)
		}
		push(a)
		push(n)
		push(uint32(toIn()))
		push(sourceID)
		push(4)
	case oRestoreInput:
		if pop() != 4 {
			abort("RESTORE-INPUT of no SAVE-INPUT")
			return
		}
		id := pop()
		in := pop()
		n := pop()
		a := pop()
		if k := inFile(); k >= 0 && id == sourceID {
			if !restoreFile(k, a, n) {
				push(0xffffffff)
				return
			}
			setToIn(int(in))
			push(0)
			return
		}
		if a != srcAddr || n != uint32(len(src)) || id != sourceID {
			push(0xffffffff)
			return
		}
		setToIn(int(in))
		push(0)
	case oDeferFetch, oDeferStore:
		w := wordOfXt(pop())
		if w < 0 || words[w].kind != kDefer {
			abort("not a DEFER")
			return
		}
		if id == oDeferFetch {
			push(peek(words[w].val))
			return
		}
		poke(words[w].val, pop())
	case oRecursive:
		// The definition being compiled can be found from here on, so
		// that it calls itself by name, as gforth's RECURSIVE has it.
		words[current].flags &^= fHidden
	case oSQuoteEsc:
		n := parseEscaped()
		if compiling() {
			a := stringHere(escBuf[:n])
			compileLit(a)
			compileLit(uint32(n))
			return
		}
		b := sbufNext()
		copy(b, escBuf[:n])
		push(uint32(uintptr(unsafe.Pointer(&b[0]))))
		push(uint32(n))
	default:
		octoFile(id)
	}
}

// The marks MARKER takes things back to.
type mark struct {
	nwords int32
	cp     int32
	dp     uint32
	nincl  int32 // the names INCLUDED, for REQUIRED
}

var (
	marks  [32]mark
	nmarks int
)

// backTo takes the dictionary and both spaces back to mark m, the MARKER
// that made it gone with what came after it.
func backTo(m int) {
	if m < 0 || m >= nmarks {
		abort("no such MARKER")
		return
	}
	for nwords > int(marks[m].nwords) {
		forget()
	}
	cp = int(marks[m].cp)
	setDpOff(marks[m].dp)
	ninclNames = int(marks[m].nincl)
	nmarks = m
}

var escBuf [256]byte

// parseEscaped parses S\"'s string up to an unescaped quote into escBuf,
// with the escapes of Forth 2012, and answers its length.
func parseEscaped() int {
	n := 0
	i := toIn()
	for i < len(src) && src[i] != '"' {
		c := src[i]
		i++
		if c == '\\' && i < len(src) {
			e := src[i]
			i++
			switch e {
			case 'a':
				c = 7
			case 'b':
				c = 8
			case 'e':
				c = 27
			case 'f':
				c = 12
			case 'l', 'n':
				c = 10
			case 'm':
				if n < len(escBuf) {
					escBuf[n] = 13
					n++
				}
				c = 10
			case 'q', '"':
				c = '"'
			case 'r':
				c = 13
			case 't':
				c = 9
			case 'v':
				c = 11
			case 'z':
				c = 0
			case 'x':
				if i+1 < len(src) && digit(src[i]) < 16 && digit(src[i+1]) < 16 {
					c = byte(digit(src[i])<<4 | digit(src[i+1]))
					i += 2
				}
			default:
				c = e
			}
		}
		if n < len(escBuf) {
			escBuf[n] = c
			n++
		}
	}
	if i < len(src) {
		i++
	}
	setToIn(i)
	return n
}
