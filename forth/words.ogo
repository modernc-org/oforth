// The words OctoGo executes. Compiled, each is a trap with its number; the
// numbers start at 1, a request of 0 being a word's return.
const (
	oDot = iota + 1
	oUDot
	oDotR
	oUDotR
	oDotS
	oEmit
	oCr
	oSpace
	oSpaces
	oType
	oKey
	oWords
	oColon
	oSemicolon
	oImmediate
	oParen
	oBackslash
	oDotParen
	oHere
	oComma
	oCComma
	oAllot
	oAlign
	oAligned
	oConstant
	oVariable
	oCreate
	oTick
	oBracketTick
	oRecurse
	oIf
	oElse
	oThen
	oBegin
	oUntil
	oAgain
	oWhile
	oRepeat
	oDo
	oQDo
	oLoop
	oPlusLoop
	oLeave
	oExit
	oLeftBracket
	oRightBracket
	oLiteral
	oDotQuote
	oSQuote
	oChar
	oBracketChar
	oStarSlash
	oStarSlashMod
	oFmMod
	oSmRem
	oDecimal
	oHex
	oFill
	oMove
	oAbort
	oDoes
	oDoesRT
	oToBody
	oPostpone
	oCompileComma
	oLessHash
	oHash
	oHashS
	oHashGreater
	oHold
	oHolds
	oSign
	oEvaluate
	oSource
	oSourceID
	oWord
	oFind
	oToNumber
	oParse
	oParseName
	oAccept
	oQuit
	oAbortQuote
	oAbortQRT
	oEnvironment
	oCase
	oOf
	oEndof
	oEndcase
	oValue
	oTo
	oDefer
	oIs
	oActionOf
	oNoname
	oErase
	oRoll
	oUnused
	oBuffer
	oCQuote
	oRefill
	oSee
	oMarker
	oMarkerRT
	oSaveInput
	oRestoreInput
	oDeferFetch
	oDeferStore
	oSQuoteEsc
	oRecursive
	oIncluded
	oInclude
	oIncludeFile
	oOpenFile
	oCloseFile
	oReadFile
	oReadLine
	oBin
)

// Words the compiler compiles where it makes something of its own.
var wType, wFetch, wStore, wExecute, wDrop, wAbort int

func octoWord(s string, id int, flags uint8) int {
	w := defineStr(s, kOcto, flags)
	words[w].id = int32(id)
	standaloneTrap(w)
	return w
}

func constWord(s string, v uint32) {
	w := defineStr(s, kConst, 0)
	words[w].val = v
	standaloneLit(w, v)
}

func octoWords() {
	const ic = fImmediate | fCompile
	// The words whose compile semantics use others look them up first.
	wFetch = findStr("@")
	wStore = findStr("!")
	wExecute = findStr("EXECUTE")
	wDrop = findStr("DROP")
	octoWord(".", oDot, 0)
	octoWord("U.", oUDot, 0)
	octoWord(".R", oDotR, 0)
	octoWord("U.R", oUDotR, 0)
	octoWord(".S", oDotS, 0)
	octoWord("EMIT", oEmit, 0)
	octoWord("CR", oCr, 0)
	octoWord("SPACE", oSpace, 0)
	octoWord("SPACES", oSpaces, 0)
	wType = octoWord("TYPE", oType, 0)
	octoWord("KEY", oKey, 0)
	octoWord("WORDS", oWords, 0)
	octoWord(":", oColon, 0)
	octoWord(";", oSemicolon, ic)
	octoWord("IMMEDIATE", oImmediate, 0)
	octoWord("(", oParen, fImmediate)
	octoWord("\\", oBackslash, fImmediate)
	octoWord(".(", oDotParen, fImmediate)
	octoWord("HERE", oHere, 0)
	octoWord(",", oComma, 0)
	octoWord("C,", oCComma, 0)
	octoWord("ALLOT", oAllot, 0)
	octoWord("ALIGN", oAlign, 0)
	octoWord("ALIGNED", oAligned, 0)
	octoWord("CONSTANT", oConstant, 0)
	octoWord("VARIABLE", oVariable, 0)
	octoWord("CREATE", oCreate, 0)
	octoWord("'", oTick, 0)
	octoWord("[']", oBracketTick, ic)
	octoWord("RECURSE", oRecurse, ic)
	octoWord("IF", oIf, ic)
	octoWord("ELSE", oElse, ic)
	octoWord("THEN", oThen, ic)
	octoWord("BEGIN", oBegin, ic)
	octoWord("UNTIL", oUntil, ic)
	octoWord("AGAIN", oAgain, ic)
	octoWord("WHILE", oWhile, ic)
	octoWord("REPEAT", oRepeat, ic)
	octoWord("DO", oDo, ic)
	octoWord("?DO", oQDo, ic)
	octoWord("LOOP", oLoop, ic)
	octoWord("+LOOP", oPlusLoop, ic)
	octoWord("LEAVE", oLeave, ic)
	octoWord("EXIT", oExit, ic)
	octoWord("[", oLeftBracket, ic)
	octoWord("]", oRightBracket, 0)
	octoWord("LITERAL", oLiteral, ic)
	octoWord(".\"", oDotQuote, ic)
	octoWord("S\"", oSQuote, fImmediate)
	octoWord("CHAR", oChar, 0)
	octoWord("[CHAR]", oBracketChar, ic)
	octoWord("*/", oStarSlash, 0)
	octoWord("*/MOD", oStarSlashMod, 0)
	octoWord("FM/MOD", oFmMod, 0)
	octoWord("SM/REM", oSmRem, 0)
	octoWord("DECIMAL", oDecimal, 0)
	octoWord("HEX", oHex, 0)
	octoWord("MOVE", oMove, 0)
	wAbort = octoWord("ABORT", oAbort, 0)
	octoWord("DOES>", oDoes, ic)
	octoWord("~does", oDoesRT, fHidden)
	octoWord(">BODY", oToBody, 0)
	octoWord("POSTPONE", oPostpone, ic)
	octoWord("COMPILE,", oCompileComma, 0)
	octoWord("<#", oLessHash, 0)
	octoWord("#", oHash, 0)
	octoWord("#S", oHashS, 0)
	octoWord("#>", oHashGreater, 0)
	octoWord("HOLD", oHold, 0)
	octoWord("HOLDS", oHolds, 0)
	octoWord("SIGN", oSign, 0)
	octoWord("EVALUATE", oEvaluate, 0)
	octoWord("SOURCE", oSource, 0)
	octoWord("SOURCE-ID", oSourceID, 0)
	octoWord("WORD", oWord, 0)
	octoWord("FIND", oFind, 0)
	octoWord(">NUMBER", oToNumber, 0)
	octoWord("PARSE", oParse, 0)
	octoWord("PARSE-NAME", oParseName, 0)
	octoWord("ACCEPT", oAccept, 0)
	octoWord("QUIT", oQuit, 0)
	octoWord("ABORT\"", oAbortQuote, ic)
	octoWord("~abort\"", oAbortQRT, fHidden)
	octoWord("ENVIRONMENT?", oEnvironment, 0)
	octoWord("CASE", oCase, ic)
	octoWord("OF", oOf, ic)
	octoWord("ENDOF", oEndof, ic)
	octoWord("ENDCASE", oEndcase, ic)
	octoWord("VALUE", oValue, 0)
	octoWord("TO", oTo, fImmediate)
	octoWord("DEFER", oDefer, 0)
	octoWord("IS", oIs, fImmediate)
	octoWord("ACTION-OF", oActionOf, fImmediate)
	octoWord(":NONAME", oNoname, 0)
	octoWord("ERASE", oErase, 0)
	octoWord("ROLL", oRoll, 0)
	octoWord("UNUSED", oUnused, 0)
	octoWord("BUFFER:", oBuffer, 0)
	octoWord("C\"", oCQuote, ic)
	octoWord("REFILL", oRefill, 0)
	octoWord("SEE", oSee, 0)
	octoWord("MARKER", oMarker, 0)
	octoWord("~marker", oMarkerRT, fHidden)
	octoWord("SAVE-INPUT", oSaveInput, 0)
	octoWord("RESTORE-INPUT", oRestoreInput, 0)
	octoWord("DEFER@", oDeferFetch, 0)
	octoWord("DEFER!", oDeferStore, 0)
	octoWord("S\\\"", oSQuoteEsc, fImmediate)
	octoWord("RECURSIVE", oRecursive, ic)
	octoWord("INCLUDED", oIncluded, 0)
	octoWord("INCLUDE", oInclude, 0)
	octoWord("INCLUDE-FILE", oIncludeFile, 0)
	octoWord("OPEN-FILE", oOpenFile, 0)
	octoWord("CLOSE-FILE", oCloseFile, 0)
	octoWord("READ-FILE", oReadFile, 0)
	octoWord("READ-LINE", oReadLine, 0)
	octoWord("BIN", oBin, 0)
	constWord("R/O", 0)
	constWord("BASE", dataBase()+cellBase*4)
	constWord("STATE", dataBase()+cellState*4)
	constWord(">IN", dataBase()+cellToIn*4)
	constWord("DP", dataBase()+cellDP*4)
	constWord("PAD", uint32(uintptr(unsafe.Pointer(&pad[0]))))
}

func findStr(s string) int {
	var b [32]byte
	for i := 0; i < len(s); i++ {
		b[i] = s[i]
	}
	w := find(b[:len(s)])
	if w < 0 {
		panic("a word is missing")
	}
	return w
}

// Init makes the system: the templates' words, OctoGo's, and the empty
// stacks. It is called once.
func Init() {
	for i := range bucket {
		bucket[i] = -1
	}
	setDpOff(dataFirst)
	data[cellBase] = 10
	setCompiling(false)
	loadTemplates()
	octoWords()
	reset()
}

// The digits of a number, written from the end of numBuf.
var numBuf [40]byte

func digits(v uint32, signed bool) []byte {
	b := base()
	if b < 2 || b > 36 {
		b = 10
	}
	neg := signed && int32(v) < 0
	if neg {
		v = -v
	}
	i := len(numBuf)
	for {
		d := v % b
		v /= b
		i--
		if d < 10 {
			numBuf[i] = byte('0' + d)
		} else {
			numBuf[i] = byte('A' + d - 10)
		}
		if v == 0 {
			break
		}
	}
	if neg {
		i--
		numBuf[i] = '-'
	}
	return numBuf[i:]
}

func spaces(n int32) {
	for ; n > 0; n-- {
		emit(' ')
	}
}

func dotR(v uint32, width int32, signed bool) {
	s := digits(v, signed)
	spaces(width - int32(len(s)))
	typeBytes(s)
}

func dotS() {
	n := depth()
	emit('<')
	typeBytes(digits(uint32(n), true))
	typeStr("> ")
	for i := n - 1; i >= 0; i-- {
		typeBytes(digits(nth(i), true))
		emit(' ')
	}
}

func listWords() {
	col := 0
	for w := nwords - 1; w >= 0; w-- {
		if words[w].flags&fHidden != 0 {
			continue
		}
		n := int(words[w].nlen)
		if col > 0 && col+n+1 > 72 {
			emit('\n')
			col = 0
		}
		if col > 0 {
			emit(' ')
			col++
		}
		typeBytes(wordName(w))
		col += n
	}
}

// nameOrAbort parses a name, which must be there.
func nameOrAbort() []byte {
	s := parseName()
	if len(s) == 0 {
		abort("a name is missing")
	}
	return s
}

func findOrAbort() int {
	s := nameOrAbort()
	if aborted {
		return -1
	}
	w := find(s)
	if w < 0 {
		abortName(s, " ?")
	}
	return w
}

// stringHere lays s down in the data space and answers where.
func stringHere(s []byte) uint32 {
	a := here()
	for _, c := range s {
		ccomma(c)
	}
	return a
}

var sbuf [256]byte // where an interpreted S" leaves its string

func d2(hi, lo uint32) int64 { return int64(uint64(hi)<<32 | uint64(lo)) }

// needs answers how many cells the OctoGo word id takes from the stack.
func needs(id int) int {
	switch id {
	case oDot, oUDot, oEmit, oSpaces, oComma, oCComma, oAllot, oAligned,
		oConstant, oLiteral:
		return 1
	case oDotR, oUDotR, oType:
		return 2
	case oStarSlash, oStarSlashMod, oFmMod, oSmRem, oFill, oMove, oAbortQRT:
		return 3
	case oDoesRT, oToBody, oCompileComma, oHold, oSign, oWord, oFind,
		oParse, oValue, oRoll, oBuffer, oQuit:
		if id == oQuit {
			return 0
		}
		return 1
	case oHash, oHashS, oHashGreater, oHolds, oEvaluate, oAccept,
		oEnvironment, oErase:
		return 2
	case oToNumber:
		return 4
	case oMarkerRT, oDeferFetch:
		return 1
	case oDeferStore:
		return 2
	case oRestoreInput:
		return 5
	case oIncluded:
		return 2
	case oIncludeFile, oCloseFile, oBin:
		return 1
	case oOpenFile, oReadFile, oReadLine:
		return 3
	}
	return 0
}

// octo executes the OctoGo word numbered id.
func octo(id int) {
	if depth() < needs(id) {
		abort("stack underflow")
		return
	}
	switch id {
	case oDot:
		typeBytes(digits(pop(), true))
		emit(' ')
	case oUDot:
		typeBytes(digits(pop(), false))
		emit(' ')
	case oDotR:
		n := int32(pop())
		dotR(pop(), n, true)
	case oUDotR:
		n := int32(pop())
		dotR(pop(), n, false)
	case oDotS:
		dotS()
	case oEmit:
		emit(byte(pop()))
	case oCr:
		emit('\n')
	case oSpace:
		emit(' ')
	case oSpaces:
		spaces(int32(pop()))
	case oType:
		n := pop()
		a := pop()
		for i := uint32(0); i < n; i++ {
			emit(peekb(a + i))
		}
	case oKey:
		if Key == nil {
			push(0xffffffff)
			return
		}
		push(uint32(inKey()))
	case oWords:
		listWords()
	case oColon:
		s := nameOrAbort()
		if !aborted {
			beginColon(s, false)
		}
	case oSemicolon:
		endColon()
	case oImmediate:
		if nwords > 0 {
			words[nwords-1].flags |= fImmediate
		}
	case oParen:
		comment()
	case oBackslash:
		setToIn(len(src))
	case oDotParen:
		typeBytes(parse(')'))
	case oHere:
		push(here())
	case oComma:
		comma(pop())
	case oCComma:
		ccomma(byte(pop()))
	case oAllot:
		allot(int32(pop()))
	case oAlign:
		align()
	case oAligned:
		push((pop() + 3) &^ 3)
	case oConstant:
		s := nameOrAbort()
		v := pop()
		if aborted {
			return
		}
		w := define(s, kConst, 0)
		if w >= 0 {
			words[w].val = v
			standaloneLit(w, v)
		}
	case oVariable, oCreate:
		s := nameOrAbort()
		if aborted {
			return
		}
		align()
		a := here()
		if id == oVariable {
			comma(0)
		}
		w := define(s, kConst, 0)
		if w >= 0 {
			words[w].val = a
			standaloneLit(w, a)
		}
	case oTick:
		w := findOrAbort()
		if w >= 0 {
			push(words[w].xt)
		}
	case oBracketTick:
		w := findOrAbort()
		if w >= 0 {
			compileLit(words[w].xt)
		}
	case oRecurse:
		flushLit()
		emitAbs(tCall, words[current].xt)
	case oIf:
		compileIf()
	case oElse:
		compileElse()
	case oThen:
		compileThen()
	case oBegin:
		compileBegin()
	case oUntil:
		compileUntil()
	case oAgain:
		compileAgain()
	case oWhile:
		compileWhile()
	case oRepeat:
		compileRepeat()
	case oDo:
		compileDo(false)
	case oQDo:
		compileDo(true)
	case oLoop:
		compileLoop(false)
	case oPlusLoop:
		compileLoop(true)
	case oLeave:
		compileLeave()
	case oExit:
		flushLit()
		inlinable = false
		lastNoRep = cp
		emitT(tExit)
	case oLeftBracket:
		flushLit()
		setCompiling(false)
	case oRightBracket:
		setCompiling(true)
	case oLiteral:
		compileLit(pop())
	case oDotQuote:
		s := parse('"')
		a := stringHere(s)
		compileLit(a)
		compileLit(uint32(len(s)))
		compileWord(wType)
	case oSQuote:
		s := parse('"')
		if compiling() {
			a := stringHere(s)
			compileLit(a)
			compileLit(uint32(len(s)))
			return
		}
		n := copy(sbuf[:], s)
		push(uint32(uintptr(unsafe.Pointer(&sbuf[0]))))
		push(uint32(n))
	case oChar:
		s := nameOrAbort()
		if !aborted {
			push(uint32(s[0]))
		}
	case oBracketChar:
		s := nameOrAbort()
		if !aborted {
			compileLit(uint32(s[0]))
		}
	case oStarSlash, oStarSlashMod:
		n3 := int64(int32(pop()))
		n2 := int64(int32(pop()))
		n1 := int64(int32(pop()))
		if n3 == 0 {
			abort("division by zero")
			return
		}
		p := n1 * n2
		if id == oStarSlashMod {
			push(uint32(p % n3))
		}
		push(uint32(p / n3))
	case oFmMod, oSmRem:
		n := int64(int32(pop()))
		hi := pop()
		lo := pop()
		if n == 0 {
			abort("division by zero")
			return
		}
		d := d2(hi, lo)
		q := d / n
		r := d % n
		if id == oFmMod && r != 0 && (r < 0) != (n < 0) {
			q--
			r += n
		}
		push(uint32(r))
		push(uint32(q))
	case oDecimal:
		data[cellBase] = 10
	case oHex:
		data[cellBase] = 16
	case oFill:
		c := byte(pop())
		n := pop()
		a := pop()
		for i := uint32(0); i < n; i++ {
			pokeb(a+i, c)
		}
	case oMove:
		n := pop()
		d := pop()
		s := pop()
		if d < s {
			for i := uint32(0); i < n; i++ {
				pokeb(d+i, peekb(s+i))
			}
		} else {
			for i := n; i > 0; i-- {
				pokeb(d+i-1, peekb(s+i-1))
			}
		}
	case oAbort:
		abortQuiet()
	default:
		octo2(id)
	}
}

var (
	pad     [128]byte
	hold    [128]byte // the pictured number, built from its end
	hld     int
	wordBuf [258]byte // WORD's counted string
	endofs  [64]int32
	nendofs int
	anon    = [...]byte{'~', 'n', 'o', 'n', 'a', 'm', 'e'}
)

func holdc(c byte) {
	if hld == 0 {
		abort("pictured number too long")
		return
	}
	hld--
	hold[hld] = c
}

func popd() uint64 {
	hi := pop()
	lo := pop()
	return uint64(hi)<<32 | uint64(lo)
}

func pushd(d uint64) {
	push(uint32(d))
	push(uint32(d >> 32))
}

// digit answers the value of c as a digit, 99 if it is none.
func digit(c byte) uint32 {
	c = upper(c)
	switch {
	case c >= '0' && c <= '9':
		return uint32(c - '0')
	case c >= 'A' && c <= 'Z':
		return uint32(c-'A') + 10
	}
	return 99
}

func setNth(n int, v uint32) {
	if n == 0 {
		eng.SetTos(v)
		return
	}
	p2.WriteLUT(eng.GetDsp()-uint32(n), v)
}

// valueOf parses a name for TO, IS and ACTION-OF, which must be of kind k.
func valueOf(k uint8) int {
	w := findOrAbort()
	if w < 0 {
		return -1
	}
	if words[w].kind != k {
		abortName(wordName(w), " is of another kind")
		return -1
	}
	return w
}

// octo2 executes the OctoGo words of M2.
func octo2(id int) {
	switch id {
	case oDoes:
		inlinable = false
		if nloops > 0 {
			// The literal below is a place in this code, which
			// taking out an open loop's reservations would move.
			cacheOff = true
		}
		// The defining word ends here, telling ~does where the code after
		// DOES> begins, which is right after this; the literal is made of
		// its full three longs so that its place is known before it is.
		flushLit()
		at := cp
		emitT(tDup)
		emitw(tplLong(tAugs, 0))
		emitw(tplLong(tLit, 0))
		emitImm(tTrap, oDoesRT)
		emitT(tExit)
		a := codeAddr(cp)
		code[at+1] |= a >> 9
		code[at+2] |= a & 511
		emitT(tEnter)
	case oDoesRT:
		d := pop()
		w := nwords - 1
		// The word may have DOES> code already: a second DOES> replaces
		// it, as when a DOES> part runs another.
		if w < 0 || words[w].kind != kConst && words[w].kind != kDoes || words[w].ret < 0 {
			abort("DOES> without CREATE")
			return
		}
		words[w].kind = kDoes
		words[w].does = d
		code[words[w].ret] = tplLong(tJmp, 0) | d&0xfffff
	case oToBody:
		w := wordOfXt(pop())
		if w < 0 || words[w].kind != kConst && words[w].kind != kDoes {
			abort(">BODY of no CREATE")
			return
		}
		push(words[w].val)
	case oPostpone:
		w := findOrAbort()
		if w < 0 {
			return
		}
		if words[w].flags&fImmediate != 0 {
			compileWord(w)
			return
		}
		compileLit(words[w].xt)
		compileWord(findStr("COMPILE,"))
	case oCompileComma:
		xt := pop()
		w := wordOfXt(xt)
		if w >= 0 {
			compileWord(w)
			return
		}
		flushLit()
		emitAbs(tCall, xt)
	case oLessHash:
		hld = len(hold)
	case oHash, oHashS:
		d := popd()
		b := uint64(base())
		for {
			r := d % b
			d /= b
			if r < 10 {
				holdc(byte('0' + r))
			} else {
				holdc(byte('A' + r - 10))
			}
			if id == oHash || d == 0 {
				break
			}
		}
		pushd(d)
	case oHashGreater:
		pop()
		pop()
		push(uint32(uintptr(unsafe.Pointer(&hold[0]))) + uint32(hld))
		push(uint32(len(hold) - hld))
	case oHold:
		holdc(byte(pop()))
	case oHolds:
		n := pop()
		a := pop()
		for i := n; i > 0; i-- {
			holdc(peekb(a + i - 1))
		}
	case oSign:
		if int32(pop()) < 0 {
			holdc('-')
		}
	case oEvaluate:
		n := pop()
		a := pop()
		evaluate(a, n)
	case oSource:
		push(srcAddr)
		push(uint32(len(src)))
	case oSourceID:
		push(sourceID)
	case oWord:
		c := byte(pop())
		skip(c)
		s := parse(c)
		n := len(s)
		if n > 255 {
			n = 255
		}
		wordBuf[0] = byte(n)
		copy(wordBuf[1:], s[:n])
		push(uint32(uintptr(unsafe.Pointer(&wordBuf[0]))))
	case oFind:
		a := pop()
		n := int(peekb(a))
		w := find(unsafe.Slice((*byte)(unsafe.Pointer(uintptr(a+1))), n))
		if w < 0 {
			push(a)
			push(0)
			return
		}
		push(words[w].xt)
		if words[w].flags&fImmediate != 0 {
			push(1)
		} else {
			push(0xffffffff)
		}
	case oToNumber:
		n := pop()
		a := pop()
		d := popd()
		b := base()
		for n > 0 {
			v := digit(peekb(a))
			if v >= b {
				break
			}
			d = d*uint64(b) + uint64(v)
			a++
			n--
		}
		pushd(d)
		push(a)
		push(n)
	case oParse:
		s := parse(byte(pop()))
		push(srcAddr + uint32(parsed))
		push(uint32(len(s)))
	case oParseName:
		s := parseName()
		push(srcAddr + uint32(parsed))
		push(uint32(len(s)))
	case oAccept:
		n := int(pop())
		a := pop()
		push(uint32(accept(a, n)))
	case oQuit:
		abortQuiet()
	case oAbortQuote:
		s := parse('"')
		a := stringHere(s)
		compileLit(a)
		compileLit(uint32(len(s)))
		flushLit()
		emitImm(tTrap, oAbortQRT)
	case oAbortQRT:
		n := pop()
		a := pop()
		if pop() != 0 {
			for i := uint32(0); i < n; i++ {
				emit(peekb(a + i))
			}
			emit('\n')
			abortQuiet()
		}
	case oEnvironment:
		pop()
		pop()
		push(0)
	case oCase:
		flushLit()
		csPush(csCase, 0, nendofs)
	case oOf:
		flushLit()
		emitT(tOf)
		at := cp
		emitAbs(tJnz, 0)
		csPush(csOf, at, 0)
	case oEndof:
		flushLit()
		e := csPop(csOf)
		if aborted {
			return
		}
		if nendofs == len(endofs) {
			abort("too many ENDOFs")
			return
		}
		endofs[nendofs] = int32(cp)
		nendofs++
		emitAbs(tJmp, 0)
		resolve(int(e.at), codeAddr(cp))
	case oEndcase:
		flushLit()
		e := csPop(csCase)
		if aborted {
			return
		}
		emitT(int(words[wDrop].id))
		for i := int(e.leave); i < nendofs; i++ {
			resolve(int(endofs[i]), codeAddr(cp))
		}
		nendofs = int(e.leave)
	case oValue:
		v := pop()
		s := nameOrAbort()
		if aborted {
			return
		}
		align()
		cell := here()
		comma(v)
		w := define(s, kValue, 0)
		if w >= 0 {
			words[w].val = cell
			standaloneValue(w, cell)
		}
	case oDefer:
		s := nameOrAbort()
		if aborted {
			return
		}
		align()
		cell := here()
		comma(words[wAbort].xt)
		w := define(s, kDefer, 0)
		if w >= 0 {
			words[w].val = cell
			standaloneDefer(w, cell)
		}
	case oTo, oIs:
		k := uint8(kValue)
		if id == oIs {
			k = kDefer
		}
		w := valueOf(k)
		if w < 0 {
			return
		}
		if compiling() {
			compileLit(words[w].val)
			compileWord(wStore)
			return
		}
		if depth() < 1 {
			abort("stack underflow")
			return
		}
		poke(words[w].val, pop())
	case oActionOf:
		w := valueOf(kDefer)
		if w < 0 {
			return
		}
		if compiling() {
			compileLit(words[w].val)
			compileWord(wFetch)
			return
		}
		push(peek(words[w].val))
	case oNoname:
		beginColon(anon[:], true)
	case oErase:
		n := pop()
		a := pop()
		for i := uint32(0); i < n; i++ {
			pokeb(a+i, 0)
		}
	case oRoll:
		u := int(pop())
		if u < 0 || u >= depth() {
			abort("stack underflow")
			return
		}
		x := nth(u)
		for i := u; i > 0; i-- {
			setNth(i, nth(i-1))
		}
		setNth(0, x)
	case oUnused:
		push(dataLongs*4 - dpOff())
	case oBuffer:
		n := pop()
		s := nameOrAbort()
		if aborted {
			return
		}
		align()
		a := here()
		if !allot(int32(n)) {
			return
		}
		w := define(s, kConst, 0)
		if w >= 0 {
			words[w].val = a
			standaloneLit(w, a)
		}
	case oCQuote:
		s := parse('"')
		a := here()
		ccomma(byte(len(s)))
		stringHere(s)
		compileLit(a)
	case oRefill:
		// A file's next line; the console's REFILL is not there yet.
		k := inFile()
		push(flag(k >= 0 && refillFile(k)))
	case oSee:
		w := findOrAbort()
		if w >= 0 {
			see(w)
		}
	case oMarker:
		s := nameOrAbort()
		if aborted {
			return
		}
		if nmarks == len(marks) {
			abort("too many MARKERs")
			return
		}
		m := nmarks
		marks[m].nwords = int32(nwords)
		marks[m].cp = int32(cp)
		marks[m].dp = dpOff()
		nmarks++
		w := define(s, kMarker, 0)
		if w < 0 {
			return
		}
		words[w].val = uint32(m)
		at := cp
		words[w].xt = codeAddr(cp)
		emitLit(uint32(m))
		emitImm(tTrap, oMarkerRT)
		emitT(tRet)
		words[w].size = int32(cp - at)
	case oMarkerRT:
		backTo(int(pop()))
	case oSaveInput:
		push(srcAddr)
		push(uint32(len(src)))
		push(uint32(toIn()))
		push(sourceID)
		push(4)
	case oRestoreInput:
		if pop() != 4 {
			abort("RESTORE-INPUT of no SAVE-INPUT")
			return
		}
		id := pop()
		in := pop()
		n := pop()
		a := pop()
		if a != srcAddr || n != uint32(len(src)) || id != sourceID {
			push(0xffffffff)
			return
		}
		setToIn(int(in))
		push(0)
	case oDeferFetch, oDeferStore:
		w := wordOfXt(pop())
		if w < 0 || words[w].kind != kDefer {
			abort("not a DEFER")
			return
		}
		if id == oDeferFetch {
			push(peek(words[w].val))
			return
		}
		poke(words[w].val, pop())
	case oRecursive:
		// The definition being compiled can be found from here on, so
		// that it calls itself by name, as gforth's RECURSIVE has it.
		words[current].flags &^= fHidden
	case oSQuoteEsc:
		n := parseEscaped()
		if compiling() {
			a := stringHere(escBuf[:n])
			compileLit(a)
			compileLit(uint32(n))
			return
		}
		copy(sbuf[:], escBuf[:n])
		push(uint32(uintptr(unsafe.Pointer(&sbuf[0]))))
		push(uint32(n))
	default:
		octoFile(id)
	}
}

// The marks MARKER takes things back to.
type mark struct {
	nwords int32
	cp     int32
	dp     uint32
}

var (
	marks  [32]mark
	nmarks int
)

// backTo takes the dictionary and both spaces back to mark m, the MARKER
// that made it gone with what came after it.
func backTo(m int) {
	if m < 0 || m >= nmarks {
		abort("no such MARKER")
		return
	}
	for nwords > int(marks[m].nwords) {
		forget()
	}
	cp = int(marks[m].cp)
	setDpOff(marks[m].dp)
	nmarks = m
}

var escBuf [256]byte

// parseEscaped parses S\"'s string up to an unescaped quote into escBuf,
// with the escapes of Forth 2012, and answers its length.
func parseEscaped() int {
	n := 0
	i := toIn()
	for i < len(src) && src[i] != '"' {
		c := src[i]
		i++
		if c == '\\' && i < len(src) {
			e := src[i]
			i++
			switch e {
			case 'a':
				c = 7
			case 'b':
				c = 8
			case 'e':
				c = 27
			case 'f':
				c = 12
			case 'l', 'n':
				c = 10
			case 'm':
				if n < len(escBuf) {
					escBuf[n] = 13
					n++
				}
				c = 10
			case 'q', '"':
				c = '"'
			case 'r':
				c = 13
			case 't':
				c = 9
			case 'v':
				c = 11
			case 'z':
				c = 0
			case 'x':
				if i+1 < len(src) && digit(src[i]) < 16 && digit(src[i+1]) < 16 {
					c = byte(digit(src[i])<<4 | digit(src[i+1]))
					i += 2
				}
			default:
				c = e
			}
		}
		if n < len(escBuf) {
			escBuf[n] = c
			n++
		}
	}
	if i < len(src) {
		i++
	}
	setToIn(i)
	return n
}
