import "modernc.org/oforth/eng"

// The templates, as eng.spin2 lays them out: a header long, the name and a
// zero, and the code from the next long. The compiler copies a template's
// code into the word it compiles; that is all the encoding there is, but
// for an immediate or an address ORed into the field the assembler left 0.
const (
	maxTemplates = 160

	tfCalls  = 0x1_0000
	tfHidden = 0x2_0000
	tfImm    = 0x4_0000
	tfSlot1  = 0x10_0000
)

var (
	tAddr  [maxTemplates]uint32 // the code
	tLen   [maxTemplates]int32  // in longs
	tFlags [maxTemplates]uint32
	tFold  [maxTemplates]int32 // the form with a literal folded in, or -1
	tName  [maxTemplates]int32 // where the name is in tNames
	tNlen  [maxTemplates]int32
	tNames [2048]byte
	ntpl   int

	// The compiler's own templates, found by name.
	tDup, tLit, tNlit, tAugs, tCall, tJmp, tJz, tJnz, tJnc, tIf   int
	tEnter, tExit, tRet, tTrap, tDo, tQdo, tLoop, tPloop, tUnloop int
	tFoldPlus, tFoldMinus, tPlus, tMinus, tOf, tUnframe           int
	tNop, tTag, tTagCmp, tRep                                     int
	ds0, dsMax, rp0                                               uint32
	missAt                                                        uint32 // the engine's cache miss
)

func tplLong(t, i int) uint32 { return peek(tAddr[t] + uint32(i)*4) }

// loadTemplates reads the table, defines a word for each template that is
// one, and finds the compiler's own.
func loadTemplates() {
	ds0 = eng.Layout(0)
	dsMax = eng.Layout(1)
	rp0 = eng.Layout(2)
	nn := 0
	p := eng.Templates()
	for {
		h := peek(p)
		if h == 0xffffffff {
			break
		}
		if ntpl == maxTemplates {
			panic("too many templates")
		}
		t := ntpl
		ntpl++
		q := p + 4
		tName[t] = int32(nn)
		for peekb(q) != 0 {
			if nn == len(tNames) {
				panic("template names")
			}
			tNames[nn] = peekb(q)
			nn++
			q++
		}
		tNlen[t] = int32(nn) - tName[t]
		q = (q + 4) &^ 3
		tAddr[t] = q
		tLen[t] = int32(h & 0xffff)
		tFlags[t] = h
		tFold[t] = -1
		p = q + uint32(tLen[t])*4
	}
	tLit = hiddenTpl("~lit")
	tNlit = hiddenTpl("~nlit")
	tAugs = hiddenTpl("~augs")
	tCall = hiddenTpl("~call")
	tJmp = hiddenTpl("~jmp")
	tJz = hiddenTpl("~jz")
	tJnz = hiddenTpl("~jnz")
	tJnc = hiddenTpl("~jnc")
	tIf = hiddenTpl("~if")
	tEnter = hiddenTpl("~enter")
	tExit = hiddenTpl("~exit")
	tRet = hiddenTpl("~ret")
	tTrap = hiddenTpl("~trap")
	tDo = hiddenTpl("~do")
	tQdo = hiddenTpl("~qdo")
	tLoop = hiddenTpl("~loop")
	tPloop = hiddenTpl("~+loop")
	tFoldPlus = hiddenTpl("~+")
	tFoldMinus = hiddenTpl("~-")
	tOf = hiddenTpl("~of")
	tUnframe = hiddenTpl("~unframe")
	tNop = hiddenTpl("~nop")
	tTag = hiddenTpl("~tag")
	tRep = hiddenTpl("~rep")
	tTagCmp = hiddenTpl("~tagcmp")
	missAt = eng.MissAddr()
	for t := 0; t < ntpl; t++ {
		if tFlags[t]&tfHidden != 0 {
			continue
		}
		w := define(tNames[tName[t]:tName[t]+tNlen[t]], kPrim, 0)
		words[w].id = int32(t)
		words[w].xt = codeAddr(cp)
		at := cp
		if tFlags[t]&tfCalls != 0 {
			emitT(tEnter)
			emitT(t)
			emitT(tExit)
		} else {
			emitT(t)
			emitT(tRet)
		}
		words[w].size = int32(cp - at)
	}
	// Each hidden "~X" is the folded form of the primitive X.
	for t := 0; t < ntpl; t++ {
		n := int(tName[t])
		if tFlags[t]&tfHidden == 0 || tNames[n] != '~' {
			continue
		}
		w := find(tNames[n+1 : n+int(tNlen[t])])
		if w >= 0 && words[w].kind == kPrim {
			tFold[words[w].id] = int32(t)
		}
	}
	tDup = primTpl("DUP")
	tUnloop = primTpl("UNLOOP")
	// What a word may not contain to be inlined: the return stack's words,
	// which in a caller would reach the caller's frame, and calls.
	for _, s := range [...]string{">R", "R>", "R@", "2>R", "2R>", "2R@", "I", "J", "UNLOOP", "EXECUTE"} {
		tNoInline[primTpl(s)] = true
	}
	tImpure[primTpl("EXECUTE")] = true
	// What a loop's body may not contain to be repeated by REP: a branch,
	// and UNLOOP, which changes the loop's limit.
	for _, s := range [...]string{"FILL", "UNLOOP", "EXECUTE"} {
		tNoRep[primTpl(s)] = true
	}
	tPlus = primTpl("+")
	tMinus = primTpl("-")
}

// hiddenTpl answers the template named s, which must exist.
func hiddenTpl(s string) int {
	for t := 0; t < ntpl; t++ {
		if int(tNlen[t]) != len(s) {
			continue
		}
		n := int(tName[t])
		same := true
		for i := 0; i < len(s); i++ {
			if tNames[n+i] != s[i] {
				same = false
				break
			}
		}
		if same {
			return t
		}
	}
	panic("a template is missing")
}

func primTpl(s string) int {
	var b [16]byte
	for i := 0; i < len(s); i++ {
		b[i] = s[i]
	}
	w := find(b[:len(s)])
	if w < 0 || words[w].kind != kPrim {
		panic("a primitive is missing")
	}
	return int(words[w].id)
}

// The code being compiled.
var (
	pending  bool // a literal not yet compiled, for the next word to fold
	pendingV uint32
	current  int // the word being defined
	startCp  int // where its code began, for an error to take it back
	startW   int

	// For the tail call and inlining: where the last call was compiled,
	// where the last branch was resolved to, and whether the definition
	// is still one that can be copied into its callers.
	lastCall  int
	landing   int
	inlinable bool
	bodyStart int

	tNoInline [maxTemplates]bool
	tImpure   [maxTemplates]bool // calls, so no loop with it is cached
	tNoRep    [maxTemplates]bool // breaks a REP: branches, or ends the loop

	// For the cache of hot loops: where the definition's absolute branches
	// are, where its last call or trap is, the loops open, and the loops
	// found cacheable inside loops not yet ended.
	branchAt   [1024]int32
	nbranch    int
	lastImpure int
	lastNoRep  int       // where the last template that breaks a REP is
	loops      [32]int32 // each open loop's first candidate
	nloops     int
	cands      [64]struct{ rs, re int32 }
	ncands     int
	tocache    [32]struct{ rs, re int32 } // cached when the definition ends
	ntocache   int
	cacheOff   bool // too much to keep track of, or code that must stay put
)

// maxCache is the longest loop, in longs, the cog RAM cache takes: the
// FCACHE area, $000-$0FF, which the backend loads its own loops into
// between our runs and which is free while a word runs.
const maxCache = 240

// maxInline is the longest body, in longs, a word may have to be inlined.
const maxInline = 16

func emitw(v uint32) {
	if cp >= len(code) {
		abort("code space full")
		return
	}
	code[cp] = v
	cp++
}

func emitT(t int) {
	for i := 0; i < int(tLen[t]); i++ {
		emitw(tplLong(t, i))
	}
}

// emitImm emits template t with v in its immediate field, preceded by an
// AUGS for the bits above the nine an instruction holds.
func emitImm(t int, v uint32) {
	if t == tTrap {
		lastImpure = cp
	}
	slot := 0
	if tFlags[t]&tfSlot1 != 0 {
		slot = 1
	}
	for i := 0; i < int(tLen[t]); i++ {
		w := tplLong(t, i)
		if i == slot {
			if v > 511 {
				emitw(tplLong(tAugs, 0) | v>>9)
				v &= 511
			}
			w |= v
		}
		emitw(w)
	}
}

// emitAbs emits a call or a branch to the hub address a.
func emitAbs(t int, a uint32) {
	inlinable = false
	if t == tCall {
		lastCall = cp
		lastImpure = cp
	} else if nbranch < len(branchAt) {
		branchAt[nbranch] = int32(cp)
		nbranch++
	} else {
		cacheOff = true
	}
	emitw(tplLong(t, 0) | a&0xfffff)
}

// resolve points the branch at code[at] to a. After an error it does
// nothing: what it was given may be the empty entry a failed csPop answers.
func resolve(at int, a uint32) {
	if aborted {
		return
	}
	if a == codeAddr(cp) {
		landing = cp
	}
	code[at] = code[at]&^0xfffff | a&0xfffff
}

func emitLit(v uint32) {
	emitT(tDup)
	switch {
	case v <= 511:
		emitImm(tLit, v)
	case -v <= 511:
		emitImm(tNlit, -v)
	default:
		emitImm(tLit, v)
	}
}

func flushLit() {
	if pending {
		pending = false
		emitLit(pendingV)
	}
}

func compileLit(v uint32) {
	flushLit()
	pending = true
	pendingV = v
}

// compileWord compiles a use of w.
func compileWord(w int) {
	switch words[w].kind {
	case kPrim:
		t := int(words[w].id)
		if pending && tFold[t] >= 0 {
			pending = false
			v := pendingV
			switch {
			case t == tPlus && v > 511 && -v <= 511:
				emitImm(tFoldMinus, -v)
			case t == tMinus && v > 511 && -v <= 511:
				emitImm(tFoldPlus, -v)
			default:
				emitImm(int(tFold[t]), v)
			}
			return
		}
		flushLit()
		if tNoInline[t] {
			inlinable = false
		}
		if tImpure[t] {
			lastImpure = cp
		}
		if tNoRep[t] {
			lastNoRep = cp
		}
		emitT(t)
	case kColon:
		flushLit()
		if words[w].val > 0 {
			// Inlined: its body, which has no call, branch or trap, and
			// may be empty. val is the body's length plus one.
			b := int(words[w].id)
			if words[w].flags&fNoRep != 0 {
				lastNoRep = cp
			}
			for i := 0; i < int(words[w].val)-1; i++ {
				emitw(code[b+i])
			}
			return
		}
		emitAbs(tCall, words[w].xt)
	case kOcto:
		flushLit()
		inlinable = false
		emitImm(tTrap, uint32(words[w].id))
	case kConst:
		compileLit(words[w].val)
	case kDoes:
		// A call of its code, which jumps to its DOES> code as it is when
		// the call runs: another DOES> may change it.
		flushLit()
		emitAbs(tCall, words[w].xt)
	case kValue:
		compileLit(words[w].val)
		compileWord(wFetch)
	case kDefer:
		compileLit(words[w].val)
		compileWord(wFetch)
		compileWord(wExecute)
	case kMarker:
		compileLit(words[w].val)
		flushLit()
		emitImm(tTrap, oMarkerRT)
	}
}

// The control-flow stack, which IF, BEGIN and DO leave for THEN, UNTIL and
// LOOP. A LEAVE's branch waits on a stack of its own for its LOOP.
const (
	csOrig = iota + 1 // a forward branch at at
	csDest            // a backward branch's target at at
	csDo              // a loop whose body starts at at, its LEAVEs from leave
	csCase            // a CASE, its ENDOFs' branches from leave
	csOf              // an OF's branch at at
)

type csEntry struct {
	kind  int32
	at    int32
	leave int32
}

var (
	cs      [32]csEntry
	ncs     int
	leaves  [64]int32
	nleaves int
)

func csPush(kind, at, leave int) {
	if ncs == len(cs) {
		abort("control structures nested too deep")
		return
	}
	cs[ncs].kind = int32(kind)
	cs[ncs].at = int32(at)
	cs[ncs].leave = int32(leave)
	ncs++
}

// csPop answers the top entry, which must be of the kind given, or aborts.
func csPop(kind int) csEntry {
	if ncs == 0 || int(cs[ncs-1].kind) != kind {
		abort("unbalanced control structure")
		var e csEntry
		return e
	}
	ncs--
	return cs[ncs]
}

func addLeave(at int) {
	if nleaves == len(leaves) {
		abort("too many LEAVEs")
		return
	}
	leaves[nleaves] = int32(at)
	nleaves++
}

// beginColon starts a definition named s; noname is :NONAME's, whose
// header stays hidden and whose xt ; pushes.
var noname bool

func beginColon(s []byte, anon bool) {
	startCp = cp
	startW = nwords
	w := define(s, kColon, fHidden)
	if w < 0 {
		return
	}
	noname = anon
	current = w
	words[w].xt = codeAddr(cp)
	ncs = 0
	nleaves = 0
	pending = false
	emitT(tEnter)
	lastCall = -1
	landing = -1
	inlinable = true
	bodyStart = cp
	nbranch = 0
	lastImpure = -1
	lastNoRep = -1
	nloops = 0
	ncands = 0
	ntocache = 0
	cacheOff = false
	setCompiling(true)
}

func endColon() {
	flushLit()
	if ncs != 0 {
		abort("unbalanced control structure")
		return
	}
	// No code moves now: the cached loops get their loaders.
	for i := 0; i < ntocache; i++ {
		cacheLoop(int(tocache[i].rs), int(tocache[i].re))
	}
	ntocache = 0
	n := cp - bodyStart
	switch {
	case lastCall >= 0 && lastCall == cp-1 && landing != cp:
		// A tail call: the frame goes first, and the word jumps to the
		// last word it calls, which returns to this one's caller.
		to := code[cp-1] & 0xfffff
		cp--
		emitT(tUnframe)
		emitAbs(tJmp, to)
	default:
		emitT(tExit)
		if inlinable && n <= maxInline {
			words[current].id = int32(bodyStart)
			words[current].val = uint32(n + 1)
			if lastNoRep >= bodyStart {
				words[current].flags |= fNoRep
			}
		}
	}
	words[current].size = int32(cp) - int32((words[current].xt-codeAddr(0))/4)
	setCompiling(false)
	if noname {
		push(words[current].xt)
		return
	}
	words[current].flags &^= fHidden
}

// discard takes back a definition an error left unfinished.
func discard() {
	if !compiling() {
		return
	}
	for nwords > startW {
		forget()
	}
	cp = startCp
	setCompiling(false)
	ncs = 0
	nleaves = 0
	pending = false
}

func compileIf() {
	flushLit()
	emitT(tIf)
	csPush(csOrig, cp, 0)
	emitAbs(tJz, 0)
}

func compileElse() {
	flushLit()
	at := cp
	emitAbs(tJmp, 0)
	e := csPop(csOrig)
	if aborted {
		return
	}
	resolve(int(e.at), codeAddr(cp))
	csPush(csOrig, at, 0)
}

func compileThen() {
	flushLit()
	e := csPop(csOrig)
	if aborted {
		return
	}
	resolve(int(e.at), codeAddr(cp))
}

// A loop's code is kept between two reservations: five longs before its
// first, for the loader that brings it into cog RAM and jumps there, and a
// long after its last, for the jump back to hub RAM. When the loop ends,
// endLoop decides whether it is cached: if not, the reservations are taken
// out; if so, they are its loader and its exit, written when the
// definition ends.
func beginLoop() {
	for i := 0; i < 5; i++ {
		emitT(tNop)
	}
	if nloops == len(loops) {
		cacheOff = true
		return
	}
	loops[nloops] = int32(ncands)
	nloops++
}

// endLoop ends the loop whose code began at rs, its exits having been
// resolved to here. A loop without calls or traps is cached if no loop
// around it is, a cached loop's inner loops going with it; when a loop
// has a call or a trap, the loops inside it found cacheable are cached.
// The loops inside one that is a candidate itself are never cached alone.
func endLoop(rs int) {
	emitT(tNop)
	re := cp
	if cacheOff || nloops == 0 || aborted {
		return
	}
	nloops--
	base := int(loops[nloops])
	// Its length once its candidates' reservations are out.
	pure := lastImpure < rs && re-rs-6*(ncands-base) <= maxCache
	if !pure {
		for i := base; i < ncands; i++ {
			if ntocache == len(tocache) {
				cacheOff = true
				return
			}
			tocache[ntocache] = cands[i]
			ntocache++
		}
		ncands = base
		squeeze(rs, re)
		return
	}
	for ncands > base {
		ncands--
		c := cands[ncands]
		squeeze(int(c.rs), int(c.re))
	}
	re = cp
	if nloops > 0 {
		if ncands == len(cands) {
			cacheOff = true
			return
		}
		cands[ncands].rs = int32(rs)
		cands[ncands].re = int32(re)
		ncands++
		return
	}
	if ntocache == len(tocache) {
		cacheOff = true
		return
	}
	tocache[ntocache].rs = int32(rs)
	tocache[ntocache].re = int32(re)
	ntocache++
}

// squeeze takes the reservations out of the loop in code[rs:re], which is
// not to be cached.
func squeeze(rs, re int) {
	cut(re-1, 1)
	cut(rs-5, 5)
}

// cut takes the n longs at code[at] out of the definition, moving down
// what follows and every place the compiler keeps of it.
func cut(at, n int) {
	for i := at; i+n < cp; i++ {
		code[i] = code[i+n]
	}
	cp -= n
	lo := codeAddr(at)
	for i := 0; i < nbranch; i++ {
		p := moved(int(branchAt[i]), at, n)
		branchAt[i] = int32(p)
		if a := code[p] & 0xfffff; a > lo {
			code[p] = code[p]&^0xfffff | codeAddr(moved(int(a-codeAddr(0))/4, at, n))&0xfffff
		}
	}
	for i := 0; i < ncs; i++ {
		cs[i].at = int32(moved(int(cs[i].at), at, n))
	}
	for i := 0; i < nleaves; i++ {
		leaves[i] = int32(moved(int(leaves[i]), at, n))
	}
	for i := 0; i < nendofs; i++ {
		endofs[i] = int32(moved(int(endofs[i]), at, n))
	}
	for i := 0; i < ncands; i++ {
		cands[i].rs = int32(moved(int(cands[i].rs), at, n))
		cands[i].re = int32(moved(int(cands[i].re), at, n))
	}
	for i := 0; i < ntocache; i++ {
		tocache[i].rs = int32(moved(int(tocache[i].rs), at, n))
		tocache[i].re = int32(moved(int(tocache[i].re), at, n))
	}
	lastCall = moved(lastCall, at, n)
	landing = moved(landing, at, n)
	lastImpure = moved(lastImpure, at, n)
	lastNoRep = moved(lastNoRep, at, n)
}

// moved answers where the long at x is after cut(at, n): past the longs
// cut, n lower; among them, at at, where what followed them is now. Only
// a branch to the first of a reservation, the loop's start, or to the
// exit long, the code after the loop, points among them.
func moved(x, at, n int) int {
	switch {
	case x >= at+n:
		return x - n
	case x > at:
		return at
	}
	return x
}

// cacheLoop makes the loop in code[rs:re] run from cog RAM: its branches
// to itself go to its place there, its last long goes back to hub RAM, and
// the five longs before it load it and jump to it.
func cacheLoop(rs, re int) {
	if aborted {
		return
	}
	base := codeAddr(rs)
	end := codeAddr(re)
	for i := 0; i < nbranch; i++ {
		p := int(branchAt[i])
		if p < rs || p >= re {
			continue
		}
		if a := code[p] & 0xfffff; a >= base && a < end {
			code[p] = code[p]&^0xfffff | (a-base)/4
		}
	}
	code[re-1] = tplLong(tJmp, 0) | end&0xfffff
	loader(rs-5, re-rs, base)
}

// loader writes at code[at] the five longs that run the n longs from base
// from cog RAM $000: the loop's tag, its address and its length less one in
// bits 27:20, is compared with the engine's CTAG, the tag of the loop cog
// RAM holds; if they differ, the engine's miss routine copies the loop in.
// Then a jump to $000.
func loader(at, n int, base uint32) {
	tag := base | uint32(n-1)<<20
	code[at] = tplLong(tAugs, 0) | tag>>9
	code[at+1] = tplLong(tTag, 0) | tag&511
	code[at+2] = tplLong(tTagCmp, 0)
	code[at+3] = tplLong(tJnz, 0) | missAt&0xfffff
	code[at+4] = tplLong(tJmp, 0)
}

func compileBegin() {
	flushLit()
	beginLoop()
	csPush(csDest, cp, 0)
}

func compileUntil() {
	flushLit()
	emitT(tIf)
	e := csPop(csDest)
	if aborted {
		return
	}
	emitAbs(tJz, codeAddr(int(e.at)))
	endLoop(int(e.at))
}

func compileAgain() {
	flushLit()
	e := csPop(csDest)
	if aborted {
		return
	}
	emitAbs(tJmp, codeAddr(int(e.at)))
	endLoop(int(e.at))
}

func compileWhile() {
	flushLit()
	emitT(tIf)
	at := cp
	emitAbs(tJz, 0)
	d := csPop(csDest)
	if aborted {
		return
	}
	csPush(csOrig, at, 0)
	csPush(csDest, int(d.at), 0)
}

func compileRepeat() {
	flushLit()
	d := csPop(csDest)
	if aborted {
		return
	}
	emitAbs(tJmp, codeAddr(int(d.at)))
	o := csPop(csOrig)
	if aborted {
		return
	}
	resolve(int(o.at), codeAddr(cp))
	endLoop(int(d.at))
}

func compileDo(q bool) {
	flushLit()
	emitT(tDo)
	base := nleaves
	if q {
		emitT(tQdo)
		addLeave(cp)
		emitAbs(tJz, 0)
	}
	beginLoop()
	// Three longs for the REP that may repeat the body, which LOOP takes
	// out if it cannot.
	csPush(csDo, cp, base)
	for i := 0; i < 3; i++ {
		emitT(tNop)
	}
}

func compileLeave() {
	flushLit()
	found := false
	for i := 0; i < ncs; i++ {
		if cs[i].kind == csDo {
			found = true
		}
	}
	if !found {
		abort("LEAVE outside a loop")
		return
	}
	addLeave(cp)
	emitAbs(tJmp, 0)
}

// compileLoop ends a DO loop. A loop that is to run from cog RAM, ended by
// LOOP, with a body of no branch, call or trap, has the body repeated by
// REP: the block is the body and LOOP's increment of LIX, and LOOP's
// compare and branch run on only when the REP did not, the count being
// 2^32. Any other loop has the REP's reservation taken out.
func compileLoop(plus bool) {
	flushLit()
	e := csPop(csDo)
	if aborted {
		return
	}
	rs := int(e.at)
	lp := cp
	if plus {
		emitT(tPloop)
		emitAbs(tJnc, codeAddr(rs+3))
	} else {
		emitT(tLoop)
		emitAbs(tJnz, codeAddr(rs+3))
	}
	for i := int(e.leave); i < nleaves; i++ {
		resolve(int(leaves[i]), codeAddr(cp))
	}
	nleaves = int(e.leave)
	emitT(tUnloop)
	switch {
	case cacheOff || aborted:
		// Nothing moves: the reservation stays, three NOPs run once.
	case !plus && repeatable(rs+3, lp) && cp+1-rs <= maxCache:
		repeat(rs, lp+1-(rs+3))
	default:
		cut(rs, 3)
	}
	endLoop(rs)
}

// repeatable answers whether the body in code[from:to] can be a REP's
// block: nothing in it may branch, call or leave the loop.
func repeatable(from, to int) bool {
	if lastImpure >= from || lastNoRep >= from {
		return false
	}
	for i := 0; i < nbranch; i++ {
		if p := int(branchAt[i]); p >= from && p < to {
			return false
		}
	}
	return true
}

// repeat writes at code[at] the REP that repeats the n longs after it as
// many times as the loop has iterations left.
func repeat(at, n int) {
	code[at] = tplLong(tRep, 0)
	code[at+1] = tplLong(tRep, 1)
	code[at+2] = tplLong(tRep, 2)&^(511<<9) | uint32(n)<<9
}

// standalone gives a word that pushes v the code that executes it.
func standaloneLit(w int, v uint32) {
	at := cp
	words[w].xt = codeAddr(cp)
	emitLit(v)
	words[w].ret = int32(cp)
	emitT(tRet)
	words[w].size = int32(cp - at)
}

func standaloneTrap(w int) {
	at := cp
	words[w].xt = codeAddr(cp)
	emitImm(tTrap, uint32(words[w].id))
	emitT(tRet)
	words[w].size = int32(cp - at)
}

// standaloneValue gives a VALUE the code that fetches it.
func standaloneValue(w int, cell uint32) {
	at := cp
	words[w].xt = codeAddr(cp)
	emitImm(int(tFold[words[wFetch].id]), cell)
	emitT(tRet)
	words[w].size = int32(cp - at)
}

// standaloneDefer gives a DEFER the code that executes what it holds.
func standaloneDefer(w int, cell uint32) {
	at := cp
	words[w].xt = codeAddr(cp)
	emitT(tEnter)
	emitImm(int(tFold[words[wFetch].id]), cell)
	emitT(int(words[wExecute].id))
	emitT(tExit)
	words[w].size = int32(cp - at)
}
